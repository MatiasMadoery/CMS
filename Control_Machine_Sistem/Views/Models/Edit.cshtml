@model Control_Machine_Sistem.Models.Model

@{
    ViewData["Title"] = "Editar";
}

<h1>Editar</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" enctype="multipart/form-data" id="uploadForm">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="CategoryId" class="control-label">Producto</label>
                <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-control">
                    <option value="">Selecciona un producto</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label>Manuales cargados</label>
                <table class="table table-bordered">                   
                    <tbody>
                        @if (Model.ManualUrls != null && Model.ManualUrls.Any())
                        {
                            @for (int i = 0; i < Model.ManualUrls.Count; i++)
                            {
                                <tr>
                                    <td>
                                        <a href="@Model.ManualUrls[i]" target="_blank" class="manual-name">@Model.ManualUrls[i]</a>
                                        <input type="hidden" name="ExistingManuals" value="@Model.ManualUrls[i]" />
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-danger btn-sm" onclick="removeExistingFile(this, 'DeletedManuals')">Eliminar</button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="2">No hay archivos cargados.</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <label>Consumibles Services cargados</label>
                <table class="table table-bordered">
                    <tbody>
                        @if (Model.SpareKitsUrls != null && Model.SpareKitsUrls.Any())
                        {
                            @for (int i = 0; i < Model.SpareKitsUrls.Count; i++)
                            {
                                <tr>
                                    <td>
                                        <a href="@Model.SpareKitsUrls[i]" target="_blank" class="spareKit-name">@Model.SpareKitsUrls[i]</a>
                                        <input type="hidden" name="ExistingSpareKits" value="@Model.SpareKitsUrls[i]" />
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-danger btn-sm" onclick="removeExistingFile(this, 'DeletedSpareKits')">Eliminar</button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="2">No hay archivos cargados.</td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
            <br />
            <div id="fileUploadContainer">
                <div class="form-group">
                    <label asp-for="Manuals" class="control-label"></label>
                    <input type="file" name="Manuals" class="form-control" />
                    <span asp-validation-for="Manuals" class="text-danger"></span>
                    <br />
                </div>
            </div>
            <div class="form-group">
                <button type="button" class="btn btn-primary" onclick="addMoreFiles('fileUploadContainer', 'Manuals')">Agregar otro archivo</button>
            </div>
            <br />
            <div id="fileUploadContainer2">
                <div class="form-group">
                    <label asp-for="SpareKits" class="control-label"></label>
                    <input type="file" name="SpareKits" class="form-control" />
                    <span asp-validation-for="SpareKits" class="text-danger"></span>
                    <br />
                </div>
            </div>
            <div class="form-group">
                <button type="button" class="btn btn-primary" onclick="addMoreFiles('fileUploadContainer2', 'SpareKits')">Agregar otro archivo</button>
            </div>
            <br />
            <br />
            <div class="form-group">
                <input type="submit" value="Guardar" class="btn btn-success" /> |
                <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {

    <script src="~/js/views.js"></script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
