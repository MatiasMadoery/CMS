@model Pager<Control_Machine_Sistem.Models.Model>

@{
    ViewData["Title"] = "Modelos";
}

<h1 class="mb-4">Modelos</h1>
<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex">
        <form asp-action="Index" method="get" class="d-flex">
            <select name="categoryId" class="form-control form-control me-4">
                <option value="">Filtrar por categoría</option>
                @foreach (var category in ViewBag.Categories)
                {
                    <option value="@category.Value" selected="@(category.Value == ViewBag.SelectedCategory?.ToString())">
                        @category.Text
                    </option>
                }
            </select>
            <button type="submit" class="btn btn-primary">Filtrar</button>
        </form>
    </div>
    <div>       
        <a asp-action="Index" asp-controller="Categories" class="btn btn-warning">Productos</a>
    </div>
</div>
<br />
<div class="mb-3">
    <a asp-action="Create" class="btn btn-success">Cargar nuevo modelo</a>
</div>

<hr />
    <table class="table table-striped table-bordered">
        <thead class="table-light">
            <tr>
                <th>@Html.DisplayNameFor(model => model.Elements.First().Name)</th>
                <th>@Html.DisplayNameFor(model => model.Elements.First().Category)</th>
                <th>Manuales</th>
                <th>Consumibles Services</th>
            </tr>       
    </thead>
        <tbody>
        @foreach (var item in Model.Elements)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.Category!.Name)</td>
                <td>
                    @if (item.ManualUrls != null && item.ManualUrls.Any())
                    {
                        <ul>
                            @foreach (var manual in item.ManualUrls)
                            {
                                <li class="manual-name" data-url="@manual">
                                    <a href="@manual" download>@manual</a>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <span>Sin manuales asociados </span>
                    }
                </td>
                <td>
                    @if (item.SpareKitsUrls != null && item.SpareKitsUrls.Any())
                    {
                        <ul>
                            @foreach (var spareKit in item.SpareKitsUrls)
                            {
                                <li class="spareKit-name" data-url="@spareKit">
                                    <a href="@spareKit" download>@spareKit</a>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <span>Sin consumibles de services asociados </span>
                    }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info">Detalle</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
    </table>

<div class="mt-3">
    @if (Model.PreviousPage)
    {
        <a asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-searchString="@ViewData["searchString"]" class="btn btn-secondary btn-sm">Anterior</a>
    }

    Página @Model.CurrentPage de @Model.TotalPages

    @if (Model.NextPage)
    {
        <a asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-searchString="@ViewData["searchString"]" class="btn btn-secondary btn-sm">Siguiente</a>
    }
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}


<script src="~/js/views.js"></script>