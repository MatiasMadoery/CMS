@model Pager<Control_Machine_Sistem.Models.Model>

@{
    ViewData["Title"] = "Modelos";
}

<link href="~/css/views.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

<div class="content-wrapper">
    <h1 class="page-title">@ViewData["Title"]</h1>

    <div class="action-bar">
        <div class="search-form">
            <form asp-action="Index" method="get" class="d-flex">
                <select name="categoryId" class="form-select me-2">
                    <option value="">Filtrar por producto</option>
                    @foreach (var category in ViewBag.Categories)
                    {
                        <option value="@category.Value" selected="@(category.Value == ViewBag.SelectedCategory?.ToString())">
                            @category.Text
                        </option>
                    }
                </select>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-filter icon"></i> Filtrar
                </button>
            </form>
        </div>
        <div class="button-group">
            <a asp-action="Index" asp-controller="Categories" class="btn btn-secondary">
                <i class="fas fa-cogs icon"></i> Productos
            </a>
            <a asp-action="Create" class="btn btn-success">
                <i class="fas fa-plus-circle icon"></i> Nuevo modelo
            </a>
        </div>
    </div>

    <hr />

    <div class="data-table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Elements.First().Name)</th>
                    <th>@Html.DisplayNameFor(model => model.Elements.First().Category)</th>
                    <th>Manuales</th>
                    <th>Consumibles / Services</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Elements)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.Category!.Name)</td>
                        <td>
                            @if (item.ManualUrls != null && item.ManualUrls.Any())
                            {
                                <ul class="model-details-list">
                                    @foreach (var manual in item.ManualUrls)
                                    {
                                        <li>
                                            <a class="manual-name" href="@manual" download>@System.IO.Path.GetFileName(manual)</a>
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <span class="text-danger">Sin manuales</span>
                            }
                        </td>
                        <td>
                            @if (item.SpareKitsUrls != null && item.SpareKitsUrls.Any())
                            {
                                <ul class="model-details-list">
                                    @foreach (var spareKit in item.SpareKitsUrls)
                                    {
                                        <li>
                                            <a class="spareKit-name" href="@spareKit" download>@System.IO.Path.GetFileName(spareKit)</a>
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <span class="text-danger">Sin consumibles</span>
                            }
                        </td>
                        <td class="table-actions">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn-action details">
                                <i class="fas fa-info-circle"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action edit">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action delete">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Elements.Any())
    {
        <div class="alert alert-warning" role="alert">
            No se encontraron resultados.
        </div>
    }

    <div class="pagination-container">
        <ul class="pagination-list">
            @{
                // Variables para limitar el número de enlaces del paginador
                int maxPagesToShow = 10; // Puedes ajustar este número
                int halfMaxPagesToShow = maxPagesToShow / 2;

                int startPage = Math.Max(1, Model.CurrentPage - halfMaxPagesToShow);
                int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + halfMaxPagesToShow);

                // Ajuste para asegurar que siempre mostremos 'maxPagesToShow' si es posible
                if (endPage - startPage + 1 < maxPagesToShow)
                {
                    if (startPage > 1)
                    {
                        startPage = Math.Max(1, endPage - maxPagesToShow + 1);
                    }
                    else if (endPage < Model.TotalPages)
                    {
                        endPage = Math.Min(Model.TotalPages, startPage + maxPagesToShow - 1);
                    }
                }
            }

            @* Enlace a la página anterior *@
            @if (Model.PreviousPage)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-searchString="@ViewData["searchString"]" asp-route-categoryId="@ViewBag.SelectedCategory">« Anterior</a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link">« Anterior</span>
                </li>
            }

            @* Primeras páginas si hay un salto *@
            @if (startPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="1" asp-route-searchString="@ViewData["searchString"]" asp-route-categoryId="@ViewBag.SelectedCategory">1</a>
                </li>
                if (startPage > 2)
                {
                    <li class="page-item disabled">
                        <span class="page-link">...</span>
                    </li>
                }
            }

            @* Enlaces de página limitados *@
            @for (int i = startPage; i <= endPage; i++)
            {
                string categoryId = ViewBag.SelectedCategory?.ToString();

                if (i == Model.CurrentPage)
                {
                    <li class="page-item active">
                        <span class="page-link">@i</span>
                    </li>
                }
                else
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchString="@ViewData["searchString"]" asp-route-categoryId="@categoryId">@i</a>
                    </li>
                }
            }

            @* Últimas páginas si hay un salto *@
            @if (endPage < Model.TotalPages)
            {
                if (endPage < Model.TotalPages - 1)
                {
                    <li class="page-item disabled">
                        <span class="page-link">...</span>
                    </li>
                }
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@Model.TotalPages" asp-route-searchString="@ViewData["searchString"]" asp-route-categoryId="@ViewBag.SelectedCategory">@Model.TotalPages</a>
                </li>
            }

            @* Enlace a la página siguiente *@
            @if (Model.NextPage)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-searchString="@ViewData["searchString"]" asp-route-categoryId="@ViewBag.SelectedCategory">Siguiente »</a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link">Siguiente »</span>
                </li>
            }
        </ul>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }
</div>

<script src="~/js/views.js"></script>