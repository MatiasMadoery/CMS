@model Control_Machine_Sistem.Models.Model

@{
    ViewData["Title"] = "Create";
}

<h1>Crear</h1>

<h4>Modelo</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" enctype="multipart/form-data" id="uploadForm">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="CategoryId" class="control-label">Categoría</label>
                <div class="d-flex">
                    <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-control-sm me-2">
                        <option value="">Selecciona una categoría</option>
                    </select>
                     <a asp-action="Create" asp-controller="Categories" class="btn btn-success btn-sm" target="_blank">
                        Crear categoría
                    </a>
                </div>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>          
            <br />
            <div id="fileUploadContainer">
                <div class="form-group">
                    <label asp-for="Manuals" class="control-label"></label>
                    <input type="file" name="Manuals" class="form-control" />
                    <span asp-validation-for="Manuals" class="text-danger"></span>
                    <br/>
                </div>
            </div>            
            <div class="form-group">
                <button type="button" class="btn btn-primary" onclick="addMoreFiles('fileUploadContainer', 'Manuals')">Agregar otro archivo</button>
            </div>
            <div id="fileUploadContainer2">
                <div class="form-group">
                    <label asp-for="SpareKits" class="control-label"></label>
                    <input type="file" name="SpareKits" class="form-control" />
                    <span asp-validation-for="SpareKits" class="text-danger"></span>
                    <br />
                </div>
            </div>
            <div class="form-group">
                <button type="button" class="btn btn-primary" onclick="addMoreFiles('fileUploadContainer2', 'SpareKits')">Agregar otro archivo</button>
            </div>
            <br />
            <br />
            <div class="form-group">
                <input type="submit" value="Crear modelo" class="btn btn-success" /> |
                <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {

    <script src="~/js/views.js"></script>
 
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
