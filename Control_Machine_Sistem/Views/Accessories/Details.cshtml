@model Control_Machine_Sistem.Models.Accessory

@{
    bool isStock = ViewBag.IsStock ?? false;
    ViewData["Title"] = "Detalles del Accesorio";
}

<link href="~/css/views.css" rel="stylesheet" />

<div class="form-container">
    <h1 class="form-title">@ViewData["Title"]</h1>
    <h4 class="form-sub-title">Información registrada del accesorio</h4>
    <hr />

    <div class="details-section">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Model)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Model)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.LoadCapacity)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.LoadCapacity)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.UbicationId)</dt>
            <dd class="col-sm-9">
                @if (Model.Ubication != null)
                {
                    <span class="badge bg-info text-dark">@Model.Ubication.Name</span>
                }
                else
                {
                    <span class="text-muted small">Sin sucursal asignada</span>
                }
            </dd>

            @if (!isStock)
            {
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SaleDate)</dt>
                <dd class="col-sm-9">@Model.SaleDate?.ToString("dd/MM/yyyy")</dd>

                <dt class="col-sm-3">Cliente / Comprador</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Customer.Name)</dd>
            }
        </dl>
    </div>

    <div class="button-group" style="margin-top: 30px;">
        @* Pasamos isStock al Edit para que el Edit sepa a dónde volver también *@
        <a asp-action="Edit" asp-route-id="@Model?.Id" asp-route-isStock="@isStock" class="btn btn-primary" asp-route-activeTab="@ViewBag.ActiveTab">
            <i class="fas fa-edit icon"></i> Editar
        </a>

        <a asp-controller="Stock" asp-action="@(isStock ? "Index" : "Vendidos")" class="btn btn-secondary" asp-route-activeTab="@ViewBag.ActiveTab">
            <i class="fas fa-arrow-left icon"></i> Volver a la lista
        </a>
    </div>
</div>