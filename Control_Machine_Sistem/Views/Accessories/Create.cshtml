@model Control_Machine_Sistem.Models.Accessory

@{
    bool isStock = ViewBag.IsStock ?? false;
    ViewData["Title"] = isStock ? "Cargar Nuevo Accesorio a Stock" : "Registrar Nueva Venta de Accesorio";
}

<link href="~/css/views.css" rel="stylesheet" />

<div class="form-container">
    <h1 class="form-title">@ViewData["Title"]</h1>
    <h4 class="form-sub-title">Complete los datos del accesorio</h4>
    <hr />

    @* Es vital pasar asp-route-isStock aquí para que el POST sepa el origen *@
    <form asp-action="Create" asp-route-isStock="@isStock" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-row">
            @if (!isStock)
            {
                <div class="form-col">
                    <div class="form-group">
                        <label asp-for="CustomerId" class="form-label">Cliente *</label>
                        <select asp-for="CustomerId" class="form-control select2" data-url="@Url.Action("GetCustomers", "Accessories")">
                            <option value="">Seleccione un Cliente...</option>
                        </select>
                        <span asp-validation-for="CustomerId" class="text-danger"></span>
                    </div>
                </div>
            }
            <div class="form-col">
                <div class="form-group">
                    <label asp-for="Model" class="form-label">Modelo / Nombre *</label>
                    <input asp-for="Model" class="form-control" placeholder="Ej: Balde 600mm" />
                    <span asp-validation-for="Model" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="form-row">
            <div class="form-col">
                <div class="form-group">
                    <label asp-for="LoadCapacity" class="form-label">Capacidad de Carga</label>
                    <input asp-for="LoadCapacity" class="form-control" placeholder="Ej: 0.5 m3" />
                    <span asp-validation-for="LoadCapacity" class="text-danger"></span>
                </div>
            </div>
            @if (!isStock)
            {
                <div class="form-col">
                    <div class="form-group">
                        <label asp-for="SaleDate" class="form-label">Fecha de Venta</label>
                        <input asp-for="SaleDate" type="date" class="form-control" />
                        <span asp-validation-for="SaleDate" class="text-danger"></span>
                    </div>
                </div>
            }
        </div>

        <div class="button-group" style="margin-top: 20px;">
            <button type="submit" class="btn btn-success">
                <i class="fas fa-plus-circle icon"></i> Crear Registro
            </button>
            <a asp-controller="Stock" asp-action="@(isStock ? "Index" : "Vendidos")" class="btn btn-secondary">
                <i class="fas fa-arrow-left icon"></i> Volver
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    @* Si usas Select2 para el buscador de clientes, asegúrate de inicializarlo aquí *@
}