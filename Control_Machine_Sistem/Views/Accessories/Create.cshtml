@model Control_Machine_Sistem.Models.Accessory

@{
    ViewData["Title"] = "Nuevo Accesorio en Stock";
}

<link href="~/css/views.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

<div class="form-container">
    <h1 class="form-title">@ViewData["Title"]</h1>
    <h4 class="form-sub-title">Registre el ingreso de una unidad física al stock</h4>
    <hr />

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-row">
            <div class="form-col">
                <div class="form-group">
                    <label for="CategoryId" class="form-label">Producto *</label>
                    <select id="CategoryId" class="form-select" asp-items="ViewBag.Categories">
                        <option value="">Seleccione un producto...</option>
                    </select>
                </div>
            </div>
            @* --- SELECCIÓN DEL MODELO DESDE EL CATÁLOGO --- *@
            <div class="form-col">
                <div class="form-group">
                    <label asp-for="AccessoryModelId" class="form-label">Modelo de Accesorio (Catálogo) *</label>
                    <select asp-for="AccessoryModelId" class="form-select" asp-items="ViewBag.AccessoryModelId">
                        <option value="">-- Seleccionar del Catálogo --</option>
                    </select>
                    <span asp-validation-for="AccessoryModelId" class="text-danger"></span>
                </div>
            </div>

            @* --- ASIGNACIÓN DE SUCURSAL / UBICACIÓN --- *@
            <div class="form-col">
                <div class="form-group">

                    <label asp-for="UbicationId" class="form-label">Sucursal / Ubicación *</label>
                    <select asp-for="UbicationId" class="form-select" asp-items="ViewBag.UbicationId">
                        <option value="">-- Seleccionar Sucursal --</option>
                    </select>
                    <span asp-validation-for="UbicationId" class="text-danger"></span>
                </div>
            </div>
        </div>

        @* --- CONTROL ADICIONAL: CARGA DE IMÁGENES (Opcional, según tu entidad) --- *@
        <div class="form-row">
            <div class="form-col" style="max-width: 50%;">
                <div class="form-group">
                    <label asp-for="ImageFiles" class="form-label">Fotos del Accesorio</label>
                    <input asp-for="ImageFiles" class="form-control" type="file" multiple />
                    <span asp-validation-for="ImageFiles" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="button-group" style="margin-top: 30px;">
            <button type="submit" class="btn btn-success">
                <i class="fas fa-save icon"></i> Registrar Ingreso Stock
            </button>
            <a asp-controller="Stock" asp-action="Index" asp-route-activeTab="accessories" class="btn btn-secondary">
                <i class="fas fa-arrow-left icon"></i> Volver al Listado
            </a>
        </div>
    </form>
</div>

<script src="~/js/accessoryCreateForm.js"></script>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}