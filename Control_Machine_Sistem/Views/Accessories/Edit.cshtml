@model Control_Machine_Sistem.Models.Accessory

@{
    bool isStock = ViewBag.IsStock ?? false;
    ViewData["Title"] = isStock ? "Editar Accesorio en Stock" : "Editar Venta de Accesorio";
}

<link href="~/css/views.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

<div class="form-container">
    <h1 class="form-title">@ViewData["Title"]</h1>
    <h4 class="form-sub-title">Modifique los datos necesarios</h4>
    <hr />

    @* 🌟 CORRECCIÓN 1: Apuntamos al parámetro 'origenStock' que configuramos en el POST del controlador *@
    <form asp-action="Edit" asp-route-origenStock="@(isStock ? "true" : "false")" method="post" enctype="multipart/form-data" id="uploadForm">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />

        @* 🌟 CORRECCIÓN 2: Eliminamos el input oculto redundante de isStock para evitar ruidos de binding *@
        <input type="hidden" name="activeTab" value="@ViewBag.ActiveTab" />

        <div class="form-row">
            <div class="form-col" style="flex: 2;">
                <div class="form-group">
                    <label asp-for="AccessoryModelId" class="form-label">Modelo de Accesorio (Catálogo) *</label>
                    <select asp-for="AccessoryModelId" class="form-select" asp-items="ViewBag.AccessoryModelId">
                        <option value="">-- Seleccionar del Catálogo --</option>
                    </select>
                    <span asp-validation-for="AccessoryModelId" class="text-danger"></span>
                </div>
            </div>

            <div class="form-col" style="flex: 1;">
                <div class="form-group">
                    <label asp-for="UbicationId" class="form-label">Ubicación / Sucursal *</label>
                    <select asp-for="UbicationId" class="form-select" asp-items="ViewBag.UbicationId">
                        <option value="">-- Seleccionar Sucursal --</option>
                    </select>
                    <span asp-validation-for="UbicationId" class="text-danger"></span>
                </div>
            </div>
        </div>

        @if (!isStock)
        {
            <div class="form-row">
                <div class="form-col">
                    <div class="form-group">
                        <label asp-for="CustomerId" class="form-label">Cliente</label>
                        <select asp-for="CustomerId" class="form-control" asp-items="ViewBag.Customers">
                            <option value="">-- Seleccionar Cliente --</option>
                        </select>
                        <span asp-validation-for="CustomerId" class="text-danger"></span>
                    </div>
                </div>
                <div class="form-col">
                    <div class="form-group">
                        <label asp-for="SaleDate" class="form-label">Fecha de Venta</label>
                        <input asp-for="SaleDate" class="form-control" type="date" />
                        <span asp-validation-for="SaleDate" class="text-danger"></span>
                    </div>
                </div>
            </div>
        }

        <h4 class="form-section-title"><i class="fas fa-images icon"></i> Fotos del Accesorio</h4>
        <div class="document-management mb-4">
            <div class="machine-photo-grid">
                @if (Model.ImageUrls != null && Model.ImageUrls.Any())
                {
                    @foreach (var url in Model.ImageUrls)
                    {
                        <div class="photo-item-edit" id="photo-@url.GetHashCode()">
                            <img src="@url" alt="Foto accesorio" class="img-thumbnail img-zoomable" onclick="openZoom(this.src)" />
                            <input type="hidden" name="ExistingImageUrls" value="@url" />
                            <button type="button" class="btn-delete-photo" onclick="markImageForDeletion('@url', '@url.GetHashCode()')">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted">No hay fotos cargadas.</p>
                }
            </div>
        </div>

        <div class="form-group mb-4">
            <label class="form-label">Subir fotos nuevas (Máximo 4 totales)</label>
            <input asp-for="ImageFiles" type="file" class="form-control" multiple accept="image/*" />
            <span asp-validation-for="ImageFiles" class="text-danger"></span>
        </div>

        <div id="deletedImagesContainer"></div>

        <div class="button-group">
            @* 🌟 CORRECCIÓN 3: Se quitó el asp-route-activeTab de acá adentro para que no rompa el envío del formulario *@
            <button type="submit" class="btn btn-success">
                <i class="fas fa-save icon"></i> Guardar Cambios
            </button>
            <a asp-controller="Stock" asp-action="@(isStock ? "Index" : "Vendidos")" class="btn btn-secondary" asp-route-activeTab="accessories">
                <i class="fas fa-arrow-left icon"></i> Cancelar
            </a>
        </div>
    </form>
</div>

@* Modal de Zoom *@
<div id="zoomModal" class="zoom-modal" onclick="closeZoom()">
    <span class="zoom-close">&times;</span>
    <img class="zoom-content" id="imgZoom">
</div>

<style>
    .machine-photo-grid {
        display: flex;
        gap: 15px;
        flex-wrap: wrap;
    }

    .photo-item-edit {
        position: relative;
        width: 120px;
        height: 120px;
    }

        .photo-item-edit img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 8px;
            cursor: pointer;
        }

    .btn-delete-photo {
        position: absolute;
        top: -5px;
        right: -5px;
        background: #ff4d4d;
        color: white;
        border: none;
        border-radius: 50%;
        width: 25px;
        height: 25px;
        cursor: pointer;
        font-size: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 5px rgba(0,0,0,0.2);
    }

    .zoom-modal {
        display: none;
        position: fixed;
        z-index: 9999;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.9);
        align-items: center;
        justify-content: center;
    }

    .zoom-content {
        max-width: 90%;
        max-height: 90%;
        border-radius: 5px;
        animation: zoomIn 0.3s;
    }

    .zoom-close {
        position: absolute;
        top: 20px;
        right: 35px;
        color: #f1f1f1;
        font-size: 40px;
        cursor: pointer;
    }

    @@keyframes zoomIn {
        from {
            transform: scale(0)
        }

        to {
            transform: scale(1)
        }
    }
</style>

@section Scripts {
    <script>
        function openZoom(src) {
            const modal = document.getElementById("zoomModal");
            const img = document.getElementById("imgZoom");
            modal.style.display = "flex";
            img.src = src;
        }

        function closeZoom() {
            document.getElementById("zoomModal").style.display = "none";
        }

        function markImageForDeletion(url, idHash) {
            if (confirm("¿Estás seguro de que quieres eliminar esta foto?")) {
                document.getElementById("photo-" + idHash).style.display = "none";
                const container = document.getElementById("deletedImagesContainer");
                const input = document.createElement("input");
                input.type = "hidden";
                input.name = "DeletedImageUrls";
                input.value = url;
                container.appendChild(input);
            }
        }
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}