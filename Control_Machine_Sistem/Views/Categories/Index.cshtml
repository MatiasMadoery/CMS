@model IEnumerable<Control_Machine_Sistem.Models.Category>

@{
    ViewData["Title"] = "Productos";
}

<link href="~/css/views.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

<div class="content-wrapper">
    <h1 class="page-title">@ViewData["Title"]</h1>

    @* --- BARRA DE ACCIONES HOMOGÉNEA (Misma estética que Modelos) --- *@
    <div class="action-bar">
        <div class="search-form">
            <form asp-action="Index" method="get" class="d-flex">
                <select name="filterType" class="form-select me-2">
                    <option value="">Filtrar por tipo</option>
                    @* Usamos el nombre string del Enum para que mapee directo en el controlador *@
                    <option value="Machine" selected="@(ViewBag.SelectedFilter?.ToString() == "Machine" || ViewBag.SelectedFilter?.ToString() == "0")">Maquinarias</option>
                    <option value="Accessory" selected="@(ViewBag.SelectedFilter?.ToString() == "Accessory" || ViewBag.SelectedFilter?.ToString() == "1")">Accesorios</option>
                </select>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-filter icon"></i> Filtrar
                </button>
                @if (ViewBag.SelectedFilter != null)
                {
                    <a asp-action="Index" class="btn btn-secondary ms-2" style="display: flex; align-items: center;">
                        <i class="fas fa-times"></i>
                    </a>
                }
            </form>
        </div>
        <div class="button-group">
            <a asp-action="Create" class="btn btn-success">
                <i class="fas fa-plus-circle icon"></i> Crear Nuevo Producto
            </a>
        </div>
    </div>

    <hr />

    <div class="data-table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Name)
                    </th>
                    <th class="table-actions">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Name)
                        </td>
                        <td class="table-actions">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action edit">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action delete">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <br />
        <div class="alert alert-warning" role="alert">
            No se encontraron productos registrados para el filtro seleccionado.
        </div>
    }

    <br />
    <div class="button-group">
        <a asp-controller="Models" asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left icon"></i> Volver a la lista de Modelos
        </a>
    </div>
</div>