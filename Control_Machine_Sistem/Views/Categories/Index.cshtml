@model IEnumerable<Control_Machine_Sistem.Models.Category>

@{
    ViewData["Title"] = "Productos";
}

<link href="~/css/views.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

<div class="content-wrapper">
    <h1 class="page-title">@ViewData["Title"]</h1>

    <div class="button-group create-button">
        <a class="btn btn-success" asp-action="Create">
            <i class="fas fa-plus-circle icon"></i> Crear Nuevo Producto
        </a>
    </div>

    <hr />

    <div class="data-table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Name)
                    </th>
                    <th class="table-actions">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Name)
                        </td>
                        <td class="table-actions">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action edit">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action delete">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <br />
    <div class="button-group">
        <a asp-controller="Models" asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left icon"></i> Volver a la lista de Modelos
        </a>
    </div>
</div>