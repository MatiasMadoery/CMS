<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Terraplane</title>
    <link rel="icon" type="image/png" href="~/img/icons/favicon.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Control_Machine_Sistem.styles.css" asp-append-version="true" />

    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/js/select2.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css" rel="stylesheet" />

    <script src="https://kit.fontawesome.com/88381571ec.js" crossorigin="anonymous"></script>
</head>
<body class="@(ViewData["BodyClass"] ?? "")">
    @if (User.Identity!.IsAuthenticated && ViewData["BodyClass"] != "login-page")
    {
        <header>
            <nav class="navbar">
                <div class="container">
                    <ul class="navbar-nav">
                        <li class="nav-item logout-item">
                            <a class="nav-link" id="logout" asp-controller="UsersLogin" asp-action="Logout">Cerrar Sesión</a>
                        </li>
                    </ul>
                </div>
            </nav>
        </header>
    }

    @if (User.Identity!.IsAuthenticated && ViewData["BodyClass"] != "login-page")
    {
        <div class="sidebar">
            <ul class="nav">

                <img src="@Url.Content("~/img/images/Logo.jpg")" alt="Logo" class="navbar-icon" />

                <li class="nav-item">
                    <a class="nav-link" asp-controller="Customers" asp-action="Index">Clientes</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Models" asp-action="Index">Modelos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Machines" asp-action="Index">Productos Vendidos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Maintenance" asp-action="Index">Mantenimientos</a>
                </li>
                @if (User.IsInRole("SuperAdmin"))
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Users" asp-action="Index">Usuarios</a>
                    </li>
                }                
            </ul>
        </div>

        <div id="menuHambur">
            <button id="btnMenuMobile" onclick="openMenu()">
                <i class="fa fa-bars"></i>
            </button>
        </div>
        <nav class="menuMobile">
            <div id="menuQuery">
                @if (User.Identity!.IsAuthenticated && ViewData["BodyClass"] != "login-page")
                {
                    <a class="nav-link" asp-controller="Customers" asp-action="Index">Clientes</a>
                    <a class="nav-link" asp-controller="Models" asp-action="Index">Modelos</a>
                    <a class="nav-link" asp-controller="Machines" asp-action="Index">Productos Vendidos</a>
                    <a class="nav-link" asp-controller="Maintenance" asp-action="Index">Mantenimientos</a>
                    @if (User.IsInRole("SuperAdmin"))
                    {
                        <a class="nav-link" asp-controller="Users" asp-action="Index">Usuarios</a>
                    }
                }                           
            </div>
        </nav>
    }



    @if (User.Identity!.IsAuthenticated && ViewData["BodyClass"] != "login-page")
    {
        <div class="content">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        @RenderBody()
    }
    
 

    @if (User.Identity!.IsAuthenticated && ViewData["BodyClass"] != "login-page")
    {
        <footer class="footer">
            <div class="container">
                <span>&copy; 2025 * Terraplane by Akron *</span>
                <span>Desarrollado por: M2.LOGIC - Todos los derechos reservados -</span>
            </div>
        </footer>
    }  
   

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>