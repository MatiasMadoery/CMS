@using Microsoft.AspNetCore.Mvc.Localization

@model Control_Machine_Sistem.Models.Customer

@{
    ViewData["Title"] = "Importar Clientes desde Excel";
}

<link href="~/css/views.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

<div class="content-wrapper">
    <h1 class="page-title">@ViewData["Title"]</h1>
    <hr />

    <div class="form-container">
        <form enctype="multipart/form-data" method="post" asp-action="ImportExcel">
            <div class="form-group">
                <label for="file" class="form-label">Selecciona un archivo Excel:</label>
                <input type="file" name="file" class="form-control" />
            </div>
            <br />
            <div class="form-group">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-file-import icon"></i> Importar Excel
                </button>
            </div>
        </form>

        <div>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left icon"></i> Volver a la lista
            </a>
        </div>
    </div>
</div>