@model Pager<Control_Machine_Sistem.Models.Customer>

@{
    ViewData["Title"] = "Clientes";
}

<link href="~/css/views.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />

<div class="content-wrapper">
    <h1 class="page-title">@ViewData["Title"]</h1>

    <div class="action-bar">
        <form method="get" id="filter-form" class="search-form">
            <input type="text" name="searchString" class="input-search" placeholder="Buscar cliente..." value="@ViewData["searchString"]" />
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-search icon"></i> Buscar
            </button>
        </form>
        <div class="button-group">
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus-circle icon"></i> Nuevo cliente
            </a>
            <a asp-action="ImportExcel" class="btn btn-secondary">
                <i class="fas fa-file-import icon"></i> Importar Excel
            </a>
        </div>
    </div>

    @if (!Model.Elements.Any())
    {
        <div class="alert alert-warning" role="alert">
            No se encontraron resultados.
        </div>
    }
    else
    {
        <div class="data-table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Elements.First().Name)</th>
                        <th>@Html.DisplayNameFor(model => model.Elements.First().LastName)</th>
                        <th>@Html.DisplayNameFor(model => model.Elements.First().Phone)</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Elements)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.Name)</td>
                            <td>@Html.DisplayFor(modelItem => item.LastName)</td>
                            <td>@Html.DisplayFor(modelItem => item.Phone)</td>
                            <td class="table-actions">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn-action details">
                                    <i class="fas fa-info-circle"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action delete">
                                    <i class="fas fa-trash-alt"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="pagination-container">
        <ul class="pagination-list">
            @if (Model.PreviousPage)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-searchString="@ViewData["searchString"]">« Anterior</a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link">« Anterior</span>
                </li>
            }

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                if (i == Model.CurrentPage)
                {
                    <li class="page-item active">
                        <span class="page-link">@i</span>
                    </li>
                }
                else
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchString="@ViewData["searchString"]">@i</a>
                    </li>
                }
            }

            @if (Model.NextPage)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-searchString="@ViewData["searchString"]">Siguiente »</a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link">Siguiente »</span>
                </li>
            }
        </ul>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }
</div>