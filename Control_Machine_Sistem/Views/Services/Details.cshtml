@model Control_Machine_Sistem.Models.Service

@{
    ViewData["Title"] = "Detalle";
    var machineId = ViewData["MachineId"];
}

<h1>Detalle</h1>

<div>
    <h4>Service</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.WorkHours)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.WorkHours)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ServiceDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ServiceDate)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.OrderNumber)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.OrderNumber)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Observations)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Observations)
        </dd>
    </dl>
</div>

<div class="form-group">
    <label>Planillas cargadas</label>
    <table class="table table-bordered">
        <tbody>
            @if (Model.ServiceSheetUrls != null && Model.ServiceSheetUrls.Any())
            {
                @for (int i = 0; i < Model.ServiceSheetUrls.Count; i++)
                {
                    var fileUrl = Model.ServiceSheetUrls[i];
                    var fileName = System.IO.Path.GetFileName(fileUrl);

                    <tr>
                        <td>
                            <a href="@fileUrl" target="_blank" class="document-name" download>
                                @fileName
                            </a>
                            <input type="hidden" name="ExistingServiceSheets" value="@fileUrl" />
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="2">No hay planillas cargadas.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div>
    <a class="btn btn-warning" asp-action="Edit" asp-route-id="@Model.Id" asp-route-machineId="@(machineId)">Editar</a> |
    <a class="btn btn-secondary" asp-action="Index" asp-route-machineId="@(machineId)">Volver a la lista</a>
</div>

@section Scripts {
    <script src="~/js/views.js"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}