@model IEnumerable<Control_Machine_Sistem.Models.Service>

@{
    ViewData["Title"] = "Services";
    var contextMachineId = ViewData["MachineId"];
    var serviceHours = Enumerable.Range(1, 8).Select(i => i * 250);
}

<h1>Services</h1>

<table class="table">
    <thead>
        <tr>
            <th>Service</th>
            <th>Horas Reales</th>
            <th>Fecha</th>
            <th>N° Orden</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var hour in serviceHours)
        {
            var service = Model.FirstOrDefault(s => s.ServiceHour == hour && s.MachineId == (int?)contextMachineId);

            <tr>
                <td>@hour</td>

                @if (service != null)
                {
                    <td>@service.WorkHours</td>
                    <td>@(service.ServiceDate?.ToString("dd/MM/yyyy"))</td>
                    <td>@service.OrderNumber</td>
                    <td>
                        <a class="btn btn-warning" asp-action="Edit" asp-route-id="@service.Id" asp-route-machineId="@service.MachineId">Editar</a> |
                        <a class="btn btn-info" asp-action="Details" asp-route-id="@service.Id" asp-route-machineId="@service.MachineId">Detalle</a> |
                        <a class="btn btn-danger" asp-action="Delete" asp-route-id="@service.Id" asp-route-machineId="@service.MachineId">Eliminar</a>
                    </td>
                }
                else
                {
                    <td colspan="4"><i>No registrado</i></td>
                    <td>
                        <a class="btn btn-success" asp-action="Create" asp-route-machineId="@contextMachineId" asp-route-serviceHour="@hour">Crear</a>
                    </td>
                }
            </tr>
        }

    </tbody>
</table>
