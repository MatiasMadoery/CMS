@model IEnumerable<Control_Machine_Sistem.Models.Service>

@{
    ViewData["Title"] = "Servicios";
    var contextMachineId = ViewData["MachineId"];
    var serviceHours = Enumerable.Range(1, 8).Select(i => i * 250);
}

<h1 class="mb-4">Servicios</h1>

<table class="table table-striped table-bordered">
    <thead class="table-light">
        <tr>
            <th>Hora de Servicio</th>
            <th>Horas Reales</th>
            <th>Fecha</th>
            <th>N° Orden</th>
            <th>Planilla Service</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var hour in serviceHours)
        {
            var service = Model.FirstOrDefault(s => s.ServiceHour == hour && s.MachineId == (int?)contextMachineId);

            <tr>
                <td>@hour</td>

                @if (service != null)
                {
                    <td>@service.WorkHours</td>
                    <td>@(service.ServiceDate?.ToString("dd/MM/yyyy"))</td>
                    <td>@service.OrderNumber</td>
                    <td>
                        @if (service.ServiceSheetUrls != null && service.ServiceSheetUrls.Any())
                        {
                            <ul class="list-unstyled">
                                @foreach (var sheetUrl in service.ServiceSheetUrls)
                                {
                                    <li>
                                        <a href="@sheetUrl" download class="btn btn-outline-primary btn-sm">
                                            @System.IO.Path.GetFileName(sheetUrl)
                                        </a>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <span class="text-muted">Sin planilla</span>
                        }
                    </td>
                    <td>
                        <div class="btn-group" role="group">
                            <a class="btn btn-warning btn-sm" asp-action="Edit" asp-route-id="@service.Id" asp-route-machineId="@service.MachineId">Editar</a>
                            <a class="btn btn-info btn-sm" asp-action="Details" asp-route-id="@service.Id" asp-route-machineId="@service.MachineId">Detalle</a>
                            <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@service.Id" asp-route-machineId="@service.MachineId">Eliminar</a>
                        </div>
                    </td>
                }
                else
                {
                    <td colspan="5"><span class="text-muted">No registrado</span></td>
                    <td>
                        <a class="btn btn-success btn-sm" asp-action="Create" asp-route-machineId="@contextMachineId" asp-route-serviceHour="@hour">Crear</a>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">
    <a asp-controller="Maintenance" asp-action="Index" class="btn btn-secondary">Volver</a>
</div>

<script src="~/js/views.js"></script>