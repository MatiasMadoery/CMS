@model Control_Machine_Sistem.Models.Service

@{
    ViewData["Title"] = "Crear";
}

<h4>Service</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="MachineId" />
            <div class="form-group">
                <label asp-for="ServiceHour" class="control-label"></label>
                <input asp-for="ServiceHour" class="form-control" readonly />
                <span asp-validation-for="ServiceHour" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="WorkHours" class="control-label"></label>
                <input asp-for="WorkHours" class="form-control" />
                <span asp-validation-for="WorkHours" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ServiceDate" class="control-label"></label>
                <input asp-for="ServiceDate" type="date" class="form-control" />
                <span asp-validation-for="ServiceDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="OrderNumber" class="control-label">N° Orden *</label>
                <input asp-for="OrderNumber" class="form-control" />
                <span asp-validation-for="OrderNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Observations" class="control-label"></label>
                <input asp-for="Observations" class="form-control" />
                <span asp-validation-for="Observations" class="text-danger"></span>
            </div>
            <div id="fileUploadContainer">
                <div class="form-group">
                    <label asp-for="ServiceSheet" class="control-label"></label>
                    <input type="file" name="ServiceSheet" class="form-control" />
                    <span asp-validation-for="ServiceSheet" class="text-danger"></span>
                    <br />
                </div>
            </div>
            <div class="form-group">
                <button type="button" class="btn btn-primary" onclick="addMoreFiles('fileUploadContainer', 'ServiceSheet')">Agregar otro archivo</button>
            </div>
            <br />
            <div class="form-group">
                <input type="submit" value="Crear" class="btn btn-success" /> |
                <a class="btn btn-secondary" asp-action="Index" asp-route-machineId="@Model.MachineId">Volver a la lista</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {

    <script src="~/js/views.js"></script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}