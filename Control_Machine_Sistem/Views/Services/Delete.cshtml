@model Control_Machine_Sistem.Models.Service

@{
    ViewData["Title"] = "Eliminar Service";
    var machineId = ViewData["MachineId"] ?? Model.MachineId;
}

<link href="~/css/views.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

<div class="content-wrapper">
    <h1 class="page-title">@ViewData["Title"]</h1>

    <div class="alert alert-danger" role="alert">
        <i class="fas fa-exclamation-triangle icon"></i>
        ¿Estás seguro de que quieres eliminar este Service?
    </div>

    <div class="details-container">
        <dl class="details-list">
            <div class="details-item">
                <dt>
                    @Html.DisplayNameFor(model => model.ServiceHour)
                </dt>
                <dd>
                    @Html.DisplayFor(model => model.ServiceHour)
                </dd>
            </div>
            <div class="details-item">
                <dt>
                    @Html.DisplayNameFor(model => model.WorkHours)
                </dt>
                <dd>
                    @Html.DisplayFor(model => model.WorkHours)
                </dd>
            </div>
            <div class="details-item">
                <dt>
                    @Html.DisplayNameFor(model => model.ServiceDate)
                </dt>
                <dd>
                    @Model.ServiceDate?.ToString("dd/MM/yyyy")
                </dd>
            </div>
            <div class="details-item">
                <dt>
                    @Html.DisplayNameFor(model => model.OrderNumber)
                </dt>
                <dd>
                    @Html.DisplayFor(model => model.OrderNumber)
                </dd>
            </div>
            <div class="details-item">
                <dt>
                    @Html.DisplayNameFor(model => model.Observations)
                </dt>
                <dd>
                    @Html.DisplayFor(model => model.Observations)
                </dd>
            </div>
        </dl>
    </div>

    @if (Model.ServiceSheetUrls != null && Model.ServiceSheetUrls.Any())
    {
        <div class="alert alert-warning">
            <strong>Atención:</strong> Los siguientes archivos se eliminarán junto con este service:
            <ul class="file-list">
                @foreach (var fileUrl in Model.ServiceSheetUrls)
                {
                    <li>
                        <a href="@fileUrl" download class="file-name-link">
                            @System.IO.Path.GetFileName(fileUrl)
                        </a>
                    </li>
                }
            </ul>
        </div>
    }

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="MachineId" />
        <div class="button-group">
            <button type="submit" class="btn btn-danger">
                <i class="fas fa-trash-alt icon"></i> Eliminar
            </button>
            <a asp-action="Index" asp-route-machineId="@(machineId)" class="btn btn-secondary">
                <i class="fas fa-arrow-left icon"></i> Volver a la lista
            </a>
        </div>
    </form>
</div>

<script src="~/js/views.js"></script>