@model Control_Machine_Sistem.Models.Pager<Control_Machine_Sistem.Models.Control_Machine_Sistem.Models.AccessoryModel>

@{
    ViewData["Title"] = "Accesorios";
}

<link href="~/css/views.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

<div class="content-wrapper">
    <h1 class="page-title">@ViewData["Title"]</h1>

    @* --- BOTONERA DE PESTAÑAS MELLIZAS (Estilo Catálogo) --- *@
    <div class="stock-header-nav mb-4">
        <div class="stock-selector">
            <div class="button-group">
                <a asp-action="Index" asp-controller="Models" class="btn btn-tab">
                    <i class="fas fa-tractor icon"></i> Máquinas
                </a>
                <a asp-action="Index" asp-controller="AccessoryModels" class="btn btn-tab active">
                    <i class="fas fa-tools icon"></i> Accesorios
                </a>
            </div>
        </div>
    </div>

    @* --- BARRA DE ACCIONES (Filtro por Producto/Categoría Desplegable) --- *@
    <div class="action-bar">
        <div class="search-form">
            <form asp-action="Index" method="get" class="d-flex">
                <select name="categoryId" class="form-select me-2">
                    <option value="">Filtrar por producto</option>
                    @if (ViewBag.Categories != null)
                    {
                        foreach (var category in ViewBag.Categories)
                        {
                            <option value="@category.Value" selected="@(category.Value == ViewBag.SelectedCategory?.ToString())">
                                @category.Text
                            </option>
                        }
                    }
                </select>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-filter icon"></i> Filtrar
                </button>
            </form>
        </div>
        <div class="button-group">
            <a asp-action="Index" asp-controller="Categories" class="btn btn-secondary">
                <i class="fas fa-cogs icon"></i> Productos
            </a>
            <a asp-action="Create" class="btn btn-success">
                <i class="fas fa-plus-circle icon"></i> Nuevo Accesorio
            </a>
        </div>
    </div>

    <hr />

    @* --- TABLA DE DATOS ESTILIZADA --- *@
    <div class="data-table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Elements.FirstOrDefault().Name)</th>
                    <th>@Html.DisplayNameFor(model => model.Elements.FirstOrDefault().Category)</th>
                    <th>@Html.DisplayNameFor(model => model.Elements.FirstOrDefault().LoadCapacity)</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Elements)
                {
                    <tr>
                        <td><strong>@Html.DisplayFor(modelItem => item.Name)</strong></td>
                        <td><span class="badge bg-light text-dark">@Html.DisplayFor(modelItem => item.Category.Name)</span></td>
                        <td>@Html.DisplayFor(modelItem => item.LoadCapacity) kg</td>
                        <td class="table-actions">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn-action details" title="Detalles">
                                <i class="fas fa-info-circle"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action edit" title="Editar">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action delete" title="Borrar">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* --- CONTROL DE DATOS VACÍOS --- *@
    @if (!Model.Elements.Any())
    {
        <div class="alert alert-warning" role="alert">
            <i class="fas fa-info-circle icon"></i> No se encontraron modelos de accesorios registrados.
        </div>
    }

    @* --- COMPONENTE DE PAGINACIÓN COMPLETO Y REPLICADO --- *@
    <div class="pagination-container">
        <ul class="pagination-list">
            @{
                int maxPagesToShow = 10;
                int halfMaxPagesToShow = maxPagesToShow / 2;

                int startPage = Math.Max(1, Model.CurrentPage - halfMaxPagesToShow);
                int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + halfMaxPagesToShow);

                if (endPage - startPage + 1 < maxPagesToShow)
                {
                    if (startPage > 1)
                    {
                        startPage = Math.Max(1, endPage - maxPagesToShow + 1);
                    }
                    else if (endPage < Model.TotalPages)
                    {
                        endPage = Math.Min(Model.TotalPages, startPage + maxPagesToShow - 1);
                    }
                }
            }

            @if (Model.PreviousPage)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-categoryId="@ViewBag.SelectedCategory">« Anterior</a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link">« Anterior</span>
                </li>
            }

            @if (startPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="1" asp-route-categoryId="@ViewBag.SelectedCategory">1</a>
                </li>
                if (startPage > 2)
                {
                    <li class="page-item disabled">
                        <span class="page-link">...</span>
                    </li>
                }
            }

            @for (int i = startPage; i <= endPage; i++)
            {
                if (i == Model.CurrentPage)
                {
                    <li class="page-item active">
                        <span class="page-link">@i</span>
                    </li>
                }
                else
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-categoryId="@ViewBag.SelectedCategory">@i</a>
                    </li>
                }
            }

            @if (endPage < Model.TotalPages)
            {
                if (endPage < Model.TotalPages - 1)
                {
                    <li class="page-item disabled">
                        <span class="page-link">...</span>
                    </li>
                }
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@Model.TotalPages" asp-route-categoryId="@ViewBag.SelectedCategory">@Model.TotalPages</a>
                </li>
            }

            @if (Model.NextPage)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-categoryId="@ViewBag.SelectedCategory">Siguiente »</a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link">Siguiente »</span>
                </li>
            }
        </ul>
    </div>

    @* --- MENSAJES DE NOTIFICACIÓN TEMPDATA --- *@
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger mt-3">
            <i class="fas fa-exclamation-circle icon"></i> @TempData["ErrorMessage"]
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success mt-3">
            <i class="fas fa-check-circle icon"></i> @TempData["SuccessMessage"]
        </div>
    }
</div>

<script src="~/js/views.js"></script>