@model Control_Machine_Sistem.Models.Ubication

@{
    ViewData["Title"] = "Nueva Sucursal";
}

<link href="~/css/views.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

<div class="content-wrapper">
    <h1 class="page-title">@ViewData["Title"]</h1>
    <h4 class="form-sub-title">Configure una nueva sucursal o depósito para la maquinaria</h4>
    <hr />

    <div class="form-container">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-section">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="Name" class="control-label">Nombre de la Sucursal</label>
                            <input asp-for="Name" class="form-control" placeholder="Ej: Sucursal Central, Depósito Norte..." />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="Address" class="control-label">Dirección / Ubicación Física</label>
                            <input asp-for="Address" class="form-control" placeholder="Calle, Ciudad o Coordenadas" />
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <hr />

            <div class="button-group">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save icon"></i> Guardar Sucursal
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left icon"></i> Volver al listado
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/views.js"></script>
}