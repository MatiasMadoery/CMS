@model IEnumerable<Control_Machine_Sistem.Models.Ubication>

@{
    ViewData["Title"] = "Gestión de Sucursales";
}

<link href="~/css/views.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

<div class="content-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="page-title">@ViewData["Title"]</h1>
            <p class="text-muted">Administre las ubicaciones físicas para la asignación de stock.</p>
        </div>
        <a asp-action="Create" class="btn btn-success">
            <i class="fas fa-plus-circle icon"></i> Nueva Sucursal
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <h5 class="mb-0"><i class="fas fa-map-marker-alt text-primary me-2"></i> Listado de Ubicaciones</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">@Html.DisplayNameFor(model => model.Name)</th>
                            <th>@Html.DisplayNameFor(model => model.Address)</th>
                            <th class="text-center" style="width: 150px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 align-middle">
                                        <strong>@Html.DisplayFor(modelItem => item.Name)</strong>
                                    </td>
                                    <td class="align-middle">
                                        <span class="text-muted">
                                            <i class="fas fa-location-dot me-1"></i>
                                            @(string.IsNullOrEmpty(item.Address) ? "Sin dirección cargada" : item.Address)
                                        </span>
                                    </td>
                                    <td class="text-center align-middle">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning" title="Editar">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger" title="Eliminar">
                                                <i class="fas fa-trash-alt"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center py-4">
                                    <i class="fas fa-info-circle fa-2x text-muted mb-2"></i>
                                    <p class="mb-0">No hay sucursales registradas aún.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a asp-controller="Stock" asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-boxes icon"></i> Volver al Stock
        </a>
    </div>
</div>

@section Scripts {
    <script src="~/js/views.js"></script>
}