@model Control_Machine_Sistem.Models.Ubication

@{
    ViewData["Title"] = "Eliminar Sucursal";
}

<link href="~/css/views.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

<div class="content-wrapper">
    <h1 class="page-title">@ViewData["Title"]</h1>
    <h4 class="form-sub-title">¿Estás seguro de que quieres eliminar esta sucursal?</h4>
    <hr />

    <div class="alert alert-danger" role="alert">
        <i class="fas fa-exclamation-triangle icon"></i>
        <strong>¡Atención!</strong> Si hay máquinas asignadas a esta ubicación, podrías generar inconsistencias en los reportes de stock.
    </div>

    <div class="details-container">
        <dl class="details-list">
            <div class="details-item">
                <dt>@Html.DisplayNameFor(model => model.Name)</dt>
                <dd>@Html.DisplayFor(model => model.Name)</dd>
            </div>
            
        </dl>
    </div>

    <hr />

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div class="button-group">
            <button type="submit" class="btn btn-danger">
                <i class="fas fa-trash-alt icon"></i> Confirmar Eliminación
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left icon"></i> Cancelar y Volver
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/views.js"></script>
}