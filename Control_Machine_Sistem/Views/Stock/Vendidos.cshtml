@model Control_Machine_Sistem.ViewModels.SoldItemViewModel
@{
    ViewData["Title"] = "Historial de Ventas";
}

<link href="~/css/views.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

<div class="content-wrapper">
    <h1 class="page-title">@ViewData["Title"]</h1>

    @* --- PANEL DE FILTROS --- *@
    <div class="filter-card shadow-sm mb-4" style="background: #fdfdfd; border: 1px solid #eee; padding: 20px; border-radius: 12px;">
        <form asp-action="Vendidos" method="get" id="filterForm">
            <input type="hidden" name="activeTab" id="inputActiveTab" value="@Model.ActiveTab" />

            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Sucursal</label>
                    <select name="ubicationId" class="form-select" asp-items="ViewBag.Ubications">
                        <option value="">-- Todas --</option>
                    </select>
                </div>
                <div class="col-md-3" id="col-filter-category">
                    <label class="form-label small fw-bold">Categoría</label>
                    <select id="filterCategory" name="categoryId" class="form-select" asp-items="ViewBag.Categories">
                        <option value="">-- Todas --</option>
                    </select>
                </div>
                <div class="col-md-3" id="col-filter-model">
                    <label class="form-label small fw-bold">Modelo</label>
                    <select id="filterModel" name="modelId" class="form-select" asp-items="ViewBag.Models">
                        <option value="">-- Todos --</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-filter icon"></i> Filtrar
                    </button>
                    <a asp-action="Vendidos" class="btn btn-outline-secondary w-100">
                        <i class="fas fa-sync-alt icon"></i> Limpiar
                    </a>
                </div>
            </div>
        </form>
    </div>

    <div class="action-bar">
        <div class="button-group">
            <button type="button" id="btn-machines" class="btn btn-tab @(Model.ActiveTab == "machines" ? "active" : "")" onclick="switchTab('machines')">
                <i class="fas fa-tractor icon"></i> Máquinas
            </button>
            <button type="button" id="btn-accessories" class="btn btn-tab @(Model.ActiveTab == "accessories" ? "active" : "")" onclick="switchTab('accessories')">
                <i class="fas fa-tools icon"></i> Accesorios
            </button>
        </div>

        <div class="button-group">
            <a asp-action="Index" asp-controller="Stock" class="btn btn-success">
                <i class="fas fa-boxes icon"></i> Ver Stock Actual
            </a>
        </div>
    </div>

    <hr />

    @* --- SECCIÓN MÁQUINAS VENDIDAS --- *@
    <div id="section-machines" style="@(Model.ActiveTab == "machines" ? "" : "display:none")">
        @if (!Model.SoldMachines.Elements.Any())
        {
            <div class="alert alert-warning">
                <i class="fas fa-info-circle icon"></i> No hay máquinas vendidas que coincidan con los filtros.
            </div>
        }
        else
        {
            <div class="data-table-container">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Razón Social</th>
                            <th>Modelo</th>
                            <th>Sucursal</th>
                            <th>Entrega Técnica</th>
                            <th>Garantía</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.SoldMachines.Elements)
                        {
                            <tr>
                                <td><strong>@item.Customer?.Name</strong></td>
                                <td>@item.Model?.Name</td>
                                <td><span class="badge bg-light text-dark">@item.Ubication?.Name</span></td>
                                <td>@item.DeliveryDate?.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="badge @(item.WarrantyExpirationDate > DateTime.Now ? "bg-success" : "bg-danger")">
                                        @item.WarrantyExpirationDate?.ToString("dd/MM/yyyy")
                                    </span>
                                </td>
                                <td class="table-actions">
                                    <a asp-action="GenerateQr" asp-controller="QrCodes" asp-route-machineId="@item.Id" class="btn-action btn-info">
                                        <i class="fas fa-qrcode"></i>
                                    </a>
                                    <a asp-action="Details" asp-controller="Machines" asp-route-id="@item.Id" class="btn-action details" title="Detalles">
                                        <i class="fas fa-info-circle"></i>
                                    </a>
                                    <a asp-action="Edit" asp-controller="Machines" asp-route-id="@item.Id" class="btn-action edit" title="Editar">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Delete" asp-controller="Machines" asp-route-id="@item.Id" class="btn-action delete" title="Eliminar">
                                        <i class="fas fa-delete"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @* Paginación Máquinas *@
            <div class="pagination-container mt-3">
                @for (int i = 1; i <= Model.SoldMachines.TotalPages; i++)
                {
                    <a href="@Url.Action("Vendidos", new { machinePage = i, activeTab = "machines", ubicationId = ViewBag.SelectedUbication, categoryId = ViewBag.SelectedCategory, modelId = ViewBag.SelectedModel })"
                       class="btn btn-sm @(i == Model.SoldMachines.CurrentPage ? "btn-primary" : "btn-outline-primary")">@i</a>
                }
            </div>
        }
    </div>

    @* --- SECCIÓN ACCESORIOS VENDIDOS --- *@
    <div id="section-accessories" style="@(Model.ActiveTab == "accessories" ? "" : "display:none")">
        @if (!Model.SoldAccessories.Elements.Any())
        {
            <div class="alert alert-warning">
                <i class="fas fa-info-circle icon"></i> No hay accesorios vendidos que coincidan con los filtros.
            </div>
        }
        else
        {
            <div class="data-table-container">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Razón Social</th>
                            <th>Accesorio / Modelo</th>
                            <th>Sucursal</th>
                            <th>Fecha de Venta</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.SoldAccessories.Elements)
                        {
                            <tr>
                                <td><strong>@item.Customer?.Name</strong></td>
                                <td>@item.Model</td>
                                <td><span class="badge bg-light text-dark">@item.Ubication?.Name</span></td>
                                <td>@item.SaleDate?.ToString("dd/MM/yyyy")</td>
                                <td class="table-actions">
                                    <a asp-action="Details" asp-controller="Accessories" asp-route-id="@item.Id" class="btn-action details" title="Detalles">
                                        <i class="fas fa-info-circle"></i>
                                    </a>
                                    <a asp-action="Edit" asp-controller="Accessories" asp-route-id="@item.Id" class="btn-action edit" title="Editar">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Delete" asp-controller="Accessories" asp-route-id="@item.Id" class="btn-action delete" title="Eliminar">
                                        <i class="fas fa-delete"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @* Paginación Accesorios *@
            <div class="pagination-container mt-3">
                @for (int i = 1; i <= Model.SoldAccessories.TotalPages; i++)
                {
                    <a href="@Url.Action("Vendidos", new { accessoryPage = i, activeTab = "accessories", ubicationId = ViewBag.SelectedUbication })"
                       class="btn btn-sm @(i == Model.SoldAccessories.CurrentPage ? "btn-primary" : "btn-outline-primary")">@i</a>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/views.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            StockManager.initCategoryCascade('@Url.Action("GetModelsByCategory", "Stock")');
        });
    </script>
}