@model Control_Machine_Sistem.ViewModels.StockViewModel
@{
    ViewData["Title"] = "Stock de Productos";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
<link href="~/css/views.css" rel="stylesheet" />

<div class="content-wrapper">
    <h1 class="page-title">@ViewData["Title"]</h1>

    @* --- PANEL DE FILTROS --- *@
    <div class="filter-card shadow-sm mb-4" style="background: #fdfdfd; border: 1px solid #eee; padding: 20px; border-radius: 12px;">
        <form asp-action="Index" method="get" id="filterForm">
            <input type="hidden" name="activeTab" id="inputActiveTab" value="@Model.ActiveTab" />

            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Sucursal</label>
                    <select name="ubicationId" class="form-select" asp-items="ViewBag.Ubications">
                        <option value="">-- Todas --</option>
                    </select>
                </div>
                <div class="col-md-3 " id="col-filter-category">
                    <label class="form-label small fw-bold">Producto</label>
                    <select id="filterCategory" name="categoryId" class="form-select" asp-items="ViewBag.Categories">
                        <option value="">-- Todas --</option>
                    </select>
                </div>
                <div class="col-md-3" id="col-filter-model">
                    <label class="form-label small fw-bold">Modelo</label>
                    <select id="filterModel" name="modelId" class="form-select" asp-items="ViewBag.Models">
                        <option value="">-- Todos --</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-filter icon"></i> Filtrar
                    </button>
                    <a asp-action="Index" class="btn btn-secondary w-100">
                        <i class="fas fa-sync-alt icon"></i> Limpiar
                    </a>
                </div>
            </div>
        </form>

        
    </div>

    <a asp-controller="Machines" asp-action="ExportarExcel" class="btn btn-success mb-3">
        <i class="fas fa-file-excel"></i> Descargar Stock Maquinas
    </a>
    <a asp-controller="Accessories" asp-action="ExportarExcelAccessories" class="btn btn-success mb-3">
        <i class="fas fa-file-excel"></i> Descargar Stock Accesorios
    </a>

    <div class="stock-header-nav">
        <div class="stock-selector">
            <div class="button-group">
                <button type="button" id="btn-machines" class="btn btn-tab @(Model.ActiveTab == "machines" ? "active" : "")"
                        onclick="switchTab('machines')">
                    <i class="fas fa-tractor icon"></i> Máquinas
                </button>
                <button type="button" id="btn-accessories" class="btn btn-tab @(Model.ActiveTab == "accessories" ? "active" : "")"
                        onclick="switchTab('accessories')">
                    <i class="fas fa-tools icon"></i> Accesorios
                </button>
            </div>
        </div>

        <div class="branch-management">
            <a asp-action="Index" asp-controller="Ubications" class="btn btn-outline-primary shadow-sm">
                <i class="fas fa-map-marked-alt icon"></i> Gestionar Sucursales
            </a>
        </div>
    </div>

    @* --- SECCIÓN MÁQUINAS --- *@
    <div id="section-machines" style="@(Model.ActiveTab == "machines" ? "" : "display:none")">
        <div class="action-bar">
            <h2 class="form-section-title"><i class="fas fa-list icon"></i> Stock de Maquinaria</h2>
            <div class="button-group">
                <a asp-action="Create" asp-controller="Machines" asp-route-isStock="true" class="btn btn-success">
                    <i class="fas fa-plus-circle icon"></i> Nueva Máquina
                </a>
            </div>
        </div>

        @if (!Model.Machines.Elements.Any())
        {
            <div class="alert alert-warning">No hay máquinas que coincidan con los filtros.</div>
        }
        else
        {
            <div class="data-table-container">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Modelo</th>
                            <th>Nº Chasis</th>
                            <th>Sucursal</th>
                            <th class="table-actions">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Machines.Elements)
                        {
                            <tr>
                                <td>@item.Model?.Name</td>
                                <td>@item.ChasisNumber</td>
                                <td><span class="badge bg-light text-dark">@item.Ubication?.Name</span></td>
                                <td class="table-actions">
                                    <a asp-action="Vender" asp-controller="Stock" asp-route-id="@item.Id" asp-route-type="Machine" class="btn-action details" style="background-color: #2ecc71;" title="Vender" asp-route-isStock="true">
                                        <i class="fas fa-shopping-cart"></i>
                                    </a>
                                    <a asp-action="Details" asp-controller="Machines" asp-route-id="@item.Id" class="btn-action details" title="Ver Detalles" asp-route-isStock="true" asp-route-activeTab="machines">
                                        <i class="fas fa-info-circle"></i>
                                    </a>
                                    @if (!string.IsNullOrEmpty(item.CheckListUrl))
                                    {
                                        <a href="@item.CheckListUrl" target="_blank" class="btn-action"
                                           style="background-color: blueviolet;" title="Ver Check List">
                                            <i class="fas fa-file-pdf"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <button class="btn-action" style="background-color: #bdc3c7; cursor: not-allowed; opacity: 0.5;"
                                                title="Sin Check List" disabled>
                                            <i class="fas fa-file-pdf"></i>
                                        </button>
                                    }
                                    <a asp-action="Edit" asp-controller="Machines" asp-route-id="@item.Id" class="btn-action edit" title="Editar" asp-route-isStock="true" asp-route-activeTab="machines">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Delete" asp-controller="Machines" asp-route-id="@item.Id" class="btn-action delete" title="Eliminar" asp-route-isStock="true" asp-route-activeTab="machines">
                                        <i class="fas fa-trash-alt"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @* --- SECCIÓN ACCESORIOS --- *@
    <div id="section-accessories" style="@(Model.ActiveTab == "accessories" ? "" : "display:none")">
        <div class="action-bar">
            <h2 class="form-section-title"><i class="fas fa-boxes icon"></i> Stock de Accesorios</h2>
            <div class="button-group">
                <a asp-action="Create" asp-controller="Accessories" asp-route-isStock="true" class="btn btn-success" asp-route-activeTab="accessories">
                    <i class="fas fa-plus-circle icon"></i> Nuevo Accesorio
                </a>
            </div>
        </div>

        @if (!Model.Accessories.Elements.Any())
        {
            <div class="alert alert-warning">No hay accesorios disponibles en stock.</div>
        }
        else
        {
            <div class="data-table-container">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Modelo/Descripción</th>
                            <th>Capacidad de Carga</th>
                            <th>Sucursal</th>
                            <th class="table-actions">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Accessories.Elements)
                        {
                            <tr>
                                @* CORRECCIÓN CLAVE: Navegación al catálogo AccessoryModel *@
                                <td>@item.AccessoryModel?.Name</td>
                                <td>@item.AccessoryModel?.LoadCapacity kg</td>
                                <td><span class="badge bg-light text-dark">@item.Ubication?.Name</span></td>
                                <td class="table-actions">
                                    <a asp-action="Vender" asp-controller="Stock" asp-route-id="@item.Id" asp-route-type="Accessory" class="btn-action details" style="background-color: #2ecc71;" title="Vender" asp-route-isStock="true">
                                        <i class="fas fa-shopping-cart"></i>
                                    </a>
                                    <a asp-action="Details" asp-controller="Accessories" asp-route-id="@item.Id" class="btn-action details" title="Ver Detalles" asp-route-isStock="true" asp-route-activeTab="accessories">
                                        <i class="fas fa-info-circle"></i>
                                    </a>
                                    <a asp-action="Edit" asp-controller="Accessories" asp-route-id="@item.Id" class="btn-action edit" title="Editar" asp-route-isStock="true" asp-route-activeTab="accessories">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Delete" asp-controller="Accessories" asp-route-id="@item.Id" class="btn-action delete" title="Eliminar" asp-route-isStock="true" asp-route-activeTab="accessories">
                                        <i class="fas fa-trash-alt"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Función centralizada para cargar modelos (sirve para Máquinas y Accesorios)
        function loadModels(tabName, categoryId, selectedModelId = null) {
            const modelSelect = document.getElementById('filterModel');
            modelSelect.innerHTML = '<option value="">-- Todos --</option>';

            if (!categoryId) return;

            // Definir endpoints correctos según el contexto
            const urlMachines = '@Url.Action("GetModelsByCategory", "Stock")';
            const urlAccessories = '@Url.Action("GetAccessoryModelsByCategory", "Stock")';

            const baseUrl = tabName === 'machines' ? urlMachines : urlAccessories;
            const url = baseUrl + '?categoryId=' + categoryId;

            fetch(url)
                .then(response => response.json())
                .then(data => {
                    data.forEach(m => {
                        const opt = document.createElement('option');
                        opt.value = m.id || m.Id;
                        opt.text = m.name || m.Name;

                        // Si venimos de un postback/búsqueda previa, preseleccionamos el modelo
                        if (selectedModelId && opt.value == selectedModelId) {
                            opt.selected = true;
                        }
                        modelSelect.appendChild(opt);
                    });
                })
                .catch(error => console.error('Error al cargar modelos:', error));
        }

        // Cambiar entre pestañas
        function switchTab(tabName) {
            // Mostrar/Ocultar secciones de las tablas
            document.getElementById('section-machines').style.display = tabName === 'machines' ? 'block' : 'none';
            document.getElementById('section-accessories').style.display = tabName === 'accessories' ? 'block' : 'none';

            // Actualizar estado visual de los botones contenedores
            document.getElementById('btn-machines').classList.toggle('active', tabName === 'machines');
            document.getElementById('btn-accessories').classList.toggle('active', tabName === 'accessories');

            const categorySelect = document.getElementById('filterCategory');

            // Recuperamos el valor seleccionado por el ViewBag si existe, sino el actual del DOM
            const currentCategorySelected = '@ViewBag.SelectedCategory' || categorySelect.value;

            // Limpiar y reconstruir select de categorías
            categorySelect.innerHTML = '<option value="">-- Todas --</option>';

            if (tabName === 'machines') {
                @foreach (var cat in (IEnumerable<Control_Machine_Sistem.Models.Category>)ViewBag.CategoriesMachine)
                {
                            <text>
                            var opt = document.createElement('option');
                            opt.value = '@cat.Id';
                            opt.text = '@cat.Name';
                            if(opt.value == currentCategorySelected) opt.selected = true;
                            categorySelect.appendChild(opt);
                            </text>
                }
            } else {
                @foreach (var cat in (IEnumerable<Control_Machine_Sistem.Models.Category>)ViewBag.CategoriesAccessory)
                {
                            <text>
                            var opt = document.createElement('option');
                            opt.value = '@cat.Id';
                            opt.text = '@cat.Name';
                            if(opt.value == currentCategorySelected) opt.selected = true;
                            categorySelect.appendChild(opt);
                            </text>
                }
            }

            // Actualizar el campo oculto del formulario
            document.getElementById('inputActiveTab').value = tabName;

            // CRUCIAL: Cargar inmediatamente los modelos heredados de la categoría activa
            const initialModelId = '@ViewBag.SelectedModel';
            loadModels(tabName, categorySelect.value, initialModelId);
        }

        // Escucha activa al cambiar manualmente el selector de "Producto" (Categoría)
        document.getElementById('filterCategory').addEventListener('change', function() {
            const tabName = document.getElementById('inputActiveTab').value;
            loadModels(tabName, this.value);
        });

        // Inicialización al cargar el documento
        document.addEventListener("DOMContentLoaded", function() {
             const currentTab = "@Model.ActiveTab";
             switchTab(currentTab);
        });
    </script>
}