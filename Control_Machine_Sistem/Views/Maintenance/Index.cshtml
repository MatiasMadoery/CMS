@model Pager<Control_Machine_Sistem.ViewModels.MaintenanceIndexViewModel>

@{
    ViewData["Title"] = "Mantenimientos";
}

<link href="~/css/views.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

<div class="content-wrapper">
    <h1 class="page-title">@ViewData["Title"]</h1>

    <div class="action-bar">
        <form method="get" id="filter-form" class="search-form">
            <input type="text" name="searchString" class="form-control" placeholder="Buscar modelo o cliente..." value="@ViewData["searchString"]" />
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-search icon"></i> Buscar
            </button>
        </form>
    </div>

    <hr />

    <div class="data-table-container">
        @if (!Model.Elements.Any())
        {
            <div class="alert alert-warning" role="alert">
                <i class="fas fa-info-circle icon"></i> No se encontraron resultados para tu búsqueda.
            </div>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Cliente</th>
                        <th>Producto</th>
                        <th>Modelo</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Elements)
                    {
                        <tr>
                            <td>@item.CustomerName</td>
                            <td>@item.MachineCategory</td>
                            <td>@item.MachineModel</td>
                            <td class="table-actions">
                                <a class="btn btn-warning" asp-controller="Services" asp-action="Index" asp-route-machineId="@item.MachineId">
                                    <i class="fas fa-tools icon"></i> Servicios
                                </a>
                                <a class="btn btn-info" asp-controller="OtherMaintenances" asp-action="Index" asp-route-machineId="@item.MachineId">
                                    <i class="fas fa-cog icon"></i> Otros Mantenimientos
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="pagination-container">
        @{
            // Parámetros de configuración para el rango visible
            int maxPagesToShow = 3; // Mostrar 3 páginas a cada lado de la actual (total de 7 si es posible)

            // Cargar parámetro de filtro para mantener el estado
            string searchString = ViewData["searchString"]?.ToString();

            // 1. Determinar el rango visible inicial
            int startPage = Math.Max(1, Model.CurrentPage - maxPagesToShow);
            int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + maxPagesToShow);

            // 2. Ajustar el rango para compensar si estamos al principio o al final
            // Esto asegura que se muestre una ventana de páginas consistente (máximo 7)
            int pagesInWindow = endPage - startPage + 1;
            if (pagesInWindow < (maxPagesToShow * 2 + 1))
            {
                if (startPage == 1)
                {
                    endPage = Math.Min(Model.TotalPages, startPage + maxPagesToShow * 2);
                }
                else if (endPage == Model.TotalPages)
                {
                    startPage = Math.Max(1, endPage - maxPagesToShow * 2);
                }
            }
        }

        <ul class="pagination-list">

            @* Botón de Página Anterior *@
            @if (Model.PreviousPage)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(Model.CurrentPage - 1)"
                       asp-route-searchString="@searchString">« Anterior</a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link">« Anterior</span>
                </li>
            }

            @* 1. Botón de la primera página (si hay un salto) *@
            @if (startPage > 1)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="1"
                       asp-route-searchString="@searchString">1</a>
                </li>
                @if (startPage > 2)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }
            }

            @* 2. Bucle principal para el rango visible *@
            @for (int i = startPage; i <= endPage; i++)
            {
                if (i == Model.CurrentPage)
                {
                    <li class="page-item active"><span class="page-link">@i</span></li>
                }
                else
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@i"
                           asp-route-searchString="@searchString">@i</a>
                    </li>
                }
            }

            @* 3. Botón de la última página (si hay un salto) *@
            @if (endPage < Model.TotalPages)
            {
                @if (endPage < Model.TotalPages - 1)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }
                <li class="page-item">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@Model.TotalPages"
                       asp-route-searchString="@searchString">@Model.TotalPages</a>
                </li>
            }

            @* Botón de Página Siguiente *@
            @if (Model.NextPage)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(Model.CurrentPage + 1)"
                       asp-route-searchString="@searchString">Siguiente »</a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link">Siguiente »</span>
                </li>
            }
        </ul>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-circle icon"></i> @TempData["ErrorMessage"]
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            <i class="fas fa-check-circle icon"></i> @TempData["SuccessMessage"]
        </div>
    }

</div>