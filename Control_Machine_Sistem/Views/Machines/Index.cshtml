@model Pager<Control_Machine_Sistem.Models.Machine>

@{
    ViewData["Title"] = "Productos Vendidos";
}

<link href="~/css/views.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

<div class="content-wrapper">
    <h1 class="page-title">@ViewData["Title"]</h1>

    <div class="action-bar">
        <form method="get" id="filter-form" class="search-form">
            <div>
                <input type="text" name="searchString" class="form-control" placeholder="Buscar cliente o modelo..." value="@ViewData["searchString"]" />
            </div>
            <div>
                <select name="categoryId" class="form-select">
                    <option value="">Filtrar por producto...</option>
                    @foreach (var category in ViewBag.Categories)
                    {
                        <option value="@category.Value" selected="@(category.Value == ViewBag.SelectedCategory?.ToString())">
                            @category.Text
                        </option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-search icon"></i> Buscar
            </button>
        </form>
        <div class="button-group">
            <a asp-action="Create" class="btn btn-success">
                <i class="fas fa-plus-circle icon"></i> Nueva venta
            </a>
        </div>
    </div>

    <hr />

    @if (!Model.Elements.Any())
    {
        <div class="alert alert-warning" role="alert">
            <i class="fas fa-info-circle icon"></i> No se encontraron resultados para tu búsqueda.
        </div>
    }
    else
    {
        <div class="data-table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Elements.First().Customer!.Name)</th>
                        <th>@Html.DisplayNameFor(model => model.Elements.First().Model!.Category!.Name)</th>
                        <th>@Html.DisplayNameFor(model => model.Elements.First().Model!.Name)</th>
                        <th>@Html.DisplayNameFor(model => model.Elements.First().DeliveryDate)</th>
                        <th>@Html.DisplayNameFor(model => model.Elements.First().WarrantyExpirationDate)</th>
                        <th>Documentación</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Elements)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.Customer!.Name)</td>
                            <td>@Html.DisplayFor(modelItem => item.Model!.Category!.Name)</td>
                            <td>@Html.DisplayFor(modelItem => item.Model!.Name)</td>
                            <td>@item.DeliveryDate?.ToString("dd/MM/yyyy")</td>
                            <td>@item.WarrantyExpirationDate?.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (item.DocUrls != null && item.DocUrls.Any())
                                {
                                    <ul class="file-list">
                                        @foreach (var doc in item.DocUrls)
                                        {
                                            <li>
                                                <a class="document-name" href="@doc" download>@System.IO.Path.GetFileName(doc)</a>
                                            </li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <span class="text-danger">Sin documentos</span>
                                }
                            </td>
                            <td class="table-actions">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn-action details">
                                    <i class="fas fa-info-circle"></i>
                                </a>
                                <a asp-action="GenerateQr" asp-controller="QrCodes" asp-route-machineId="@item.Id" class="btn-action btn-info">
                                    <i class="fas fa-qrcode"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action delete">
                                    <i class="fas fa-trash-alt"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="pagination-container">
        @{
            // Parámetros de configuración para el rango visible
            int maxPagesToShow = 5; // Mostrar 5 páginas a cada lado de la actual (total de 11 si es posible)

            // Cargar parámetros de filtro para mantener el estado
            string searchString = ViewData["searchString"]?.ToString();
            string categoryId = ViewData["categoryId"]?.ToString();

            // 1. Determinar el rango visible
            int startPage = Math.Max(1, Model.CurrentPage - maxPagesToShow);
            int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + maxPagesToShow);

            // 2. Ajustar el rango para compensar si estamos al principio o al final
            int pagesInWindow = endPage - startPage + 1;
            if (pagesInWindow < (maxPagesToShow * 2 + 1))
            {
                if (startPage == 1)
                {
                    endPage = Math.Min(Model.TotalPages, startPage + maxPagesToShow * 2);
                }
                else if (endPage == Model.TotalPages)
                {
                    startPage = Math.Max(1, endPage - maxPagesToShow * 2);
                }
            }
        }

        <ul class="pagination-list">

            @* Botón de Página Anterior *@
            @if (Model.PreviousPage)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(Model.CurrentPage - 1)"
                       asp-route-searchString="@searchString"
                       asp-route-categoryId="@categoryId">« Anterior</a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link">« Anterior</span>
                </li>
            }

            @* 1. Botón de la primera página (si hay un salto) *@
            @if (startPage > 1)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="1"
                       asp-route-searchString="@searchString"
                       asp-route-categoryId="@categoryId">1</a>
                </li>
                @if (startPage > 2)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }
            }

            @* 2. Bucle principal para el rango visible *@
            @for (int i = startPage; i <= endPage; i++)
            {
                if (i == Model.CurrentPage)
                {
                    <li class="page-item active"><span class="page-link">@i</span></li>
                }
                else
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@i"
                           asp-route-searchString="@searchString"
                           asp-route-categoryId="@categoryId">@i</a>
                    </li>
                }
            }

            @* 3. Botón de la última página (si hay un salto) *@
            @if (endPage < Model.TotalPages)
            {
                @if (endPage < Model.TotalPages - 1)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }
                <li class="page-item">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@Model.TotalPages"
                       asp-route-searchString="@searchString"
                       asp-route-categoryId="@categoryId">@Model.TotalPages</a>
                </li>
            }

            @* Botón de Página Siguiente *@
            @if (Model.NextPage)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(Model.CurrentPage + 1)"
                       asp-route-searchString="@searchString"
                       asp-route-categoryId="@categoryId">Siguiente »</a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link">Siguiente »</span>
                </li>
            }
        </ul>
    </div>
</div>

<script src="~/js/views.js"></script>