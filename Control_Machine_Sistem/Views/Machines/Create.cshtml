@model Control_Machine_Sistem.Models.Machine

@{
    bool isStock = ViewBag.IsStock ?? false;
    ViewData["Title"] = isStock ? "Cargar Máquina a Stock" : "Crear Venta";
}

<link href="~/css/views.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

<div class="form-container">
    <h1 class="form-title">@ViewData["Title"]</h1>
    <h4 class="form-sub-title">@(isStock ? "Nueva unidad para inventario" : "Nueva Venta Directa")</h4>
    <hr />

    @* IMPORTANTE: Enviamos el parámetro isStock al POST *@
    <form asp-action="Create" asp-route-isStock="@isStock" method="post" enctype="multipart/form-data" id="uploadForm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-row">
            @if (!isStock)
            {
                <div class="form-col">
                    <div class="form-group">
                        <label asp-for="CustomerId" class="form-label">Cliente *</label>
                        <select asp-for="CustomerId" class="form-control select2" data-url="@Url.Action("GetCustomers", "Machines")">
                            <option value="">Seleccione un Cliente...</option>
                        </select>
                        <span asp-validation-for="CustomerId" class="text-danger"></span>
                    </div>
                </div>
            }
            <div class="form-col">
                <div class="form-group">
                    <label for="CategoryId" class="form-label">Producto *</label>
                    <select id="CategoryId" class="form-select">
                        <option value="">Seleccione un producto...</option>
                        @foreach (var category in ViewBag.Categories)
                        {
                            <option value="@category.Value">@category.Text</option>
                        }
                    </select>
                </div>
            </div>
            <div class="form-col">
                <div class="form-group">
                    <label asp-for="ModelId" class="form-label">Modelo *</label>
                    <select asp-for="ModelId" id="ModelId" class="form-select">
                        <option value="">Seleccione un modelo...</option>
                    </select>
                    <span asp-validation-for="ModelId" class="text-danger"></span>
                </div>
            </div>
        </div>

        @*Nuevas prop*@
        <div class="form-row">
            <div class="form-col">
                <div class="form-group">
                    <label asp-for="ImportNumber" class="form-label">Número de Importación *</label>
                    <input asp-for="ImportNumber" class="form-control" type="number"/>
                    <span asp-validation-for="ImportNumber" class="text-danger"></span>
                </div>
            </div>
            <div class="form-col">
                <div class="form-group">
                    <label asp-for="OfficializationDate" class="form-label">Fecha de Oficialización *</label>
                    <input asp-for="OfficializationDate" class="form-control" type="date"/>
                    <span asp-validation-for="OfficializationDate" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="form-row">
            <div class="form-col">
                <div class="form-group">
                    <label asp-for="ChasisNumber" class="form-label">Número de chasis *</label>
                    <input asp-for="ChasisNumber" class="form-control" />
                    <span asp-validation-for="ChasisNumber" class="text-danger"></span>
                </div>
            </div>
            <div class="form-col">
                <div class="form-group">
                    <label asp-for="EngineNumber" class="form-label">Número de motor *</label>
                    <input asp-for="EngineNumber" class="form-control" />
                    <span asp-validation-for="EngineNumber" class="text-danger"></span>
                </div>
            </div>
            <div class="form-col">
                <div class="form-group">
                    <label asp-for="SerialNumber" class="form-label">Número de Serie</label>
                    <input asp-for="SerialNumber" class="form-control" />
                    <span asp-validation-for="SerialNumber" class="text-danger"></span>
                </div>
            </div>
        </div>
        <div class="form-row">
            <div class="form-col">
                <div class="form-group">
                    <label asp-for="ManufactureYear" class="form-label">Año de Fabricación</label>
                    <input asp-for="ManufactureYear" class="form-control" type="number" min="1900" max="@DateTime.Now.Year" />
                    <span asp-validation-for="ManufactureYear" class="text-danger"></span>
                </div>
            </div>
            <div class="form-col">
                <div class="form-group">
                    <label asp-for="UserHours" class="form-label">Horas de uso</label>
                    <input asp-for="UserHours" class="form-control" type="number" step="0.1" />
                    <span asp-validation-for="UserHours" class="text-danger"></span>
                </div>
            </div>
            <div class="form-col">
                <div class="form-group">
                    <label asp-for="UbicationId" class="form-label">Sucursal / Ubicación *</label>
                    <select asp-for="UbicationId" class="form-select" asp-items="ViewBag.UbicationId">
                        <option value="">-- Seleccionar Ubicación --</option>
                    </select>
                    <span asp-validation-for="UbicationId" class="text-danger"></span>
                </div>
            </div>
        </div>
        @* AGREGADO: Solo mostrar fechas si NO es stock *@
        @if (!isStock)
        {
            <div class="form-row">
                <div class="form-col">
                    <div class="form-group">
                        <label asp-for="DeliveryDate" class="form-label">Fecha de entrega técnica *</label>
                        <input asp-for="DeliveryDate" class="form-control" type="date" />
                        <span asp-validation-for="DeliveryDate" class="text-danger"></span>
                    </div>
                </div>
                <div class="form-col">
                    <div class="form-group">
                        <label class="form-label">Fecha de vencimiento de garantía</label>
                        <input class="form-control" type="date" id="warrantyDatePreview" readonly />
                    </div>
                </div>
            </div>
        }

        <h4 class="form-section-title">Documentación</h4>
        <div id="fileUploadContainer">
            <div class="form-group">
                <label asp-for="Documentations" class="form-label"></label>
                <input type="file" name="Documentations" class="form-control" multiple />
                <span asp-validation-for="Documentations" class="text-danger"></span>
            </div>
        </div>
        <div class="form-group">
            <button type="button" class="btn btn-primary" onclick="addMoreFiles('fileUploadContainer', 'Documentations')">
                <i class="fas fa-plus icon"></i> Agregar otro archivo
            </button>
        </div>

        <h4 class="form-section-title">Checklist de Entrega</h4>
        <div class="form-row">
            <div class="form-col">
                <div class="form-group">
                    <label asp-for="CheckListFile" class="form-label">Archivo de Checklist (PDF)</label>
                    <input asp-for="CheckListFile" type="file" class="form-control" accept="application/pdf" id="checkListInput" />
                    <span asp-validation-for="CheckListFile" class="text-danger"></span>
                    <small class="text-muted">Suba el informe de inspección o checklist en formato PDF.</small>
                </div>
            </div>
        </div>

        @* --- SECCIÓN NUEVA: FOTOS DE LA MÁQUINA (Solo si es Stock) --- *@
        @if (isStock)
        {
            <h4 class="form-section-title">Fotos de la Unidad</h4>
            <div class="form-row">
                <div class="form-col">
                    <div class="form-group">
                        <label asp-for="ImageFiles" class="form-label">Imágenes de Stock (Máximo 4) *</label>
                        <input asp-for="ImageFiles" type="file" class="form-control" multiple accept="image/*" id="imageInput" />
                        <span asp-validation-for="ImageFiles" class="text-danger"></span>
                        <small class="text-muted">Formatos permitidos: JPG, PNG. Se recomienda seleccionar las 4 fotos juntas.</small>
                    </div>
                </div>
            </div>
            @* Contenedor opcional para ver miniaturas antes de subir *@
            <div id="imagePreviewContainer" class="d-flex flex-wrap gap-2 mb-3"></div>
        }

        <div class="button-group">
            <input type="submit" value="@(isStock ? "Cargar a Stock" : "Crear Venta")" class="btn btn-success" />
            @* AJUSTADO: El volver depende de si es stock *@
            <a asp-action="Index" asp-controller="@(isStock ? "Stock" : "Machines")" class="btn btn-secondary">
                <i class="fas fa-arrow-left icon"></i> Volver
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/site.js"></script>
    <script src="~/js/views.js"></script>
    <script src="~/js/machineCreateForm.js"></script>
    <script>

                // Validación para el Checklist
        document.getElementById('checkListInput')?.addEventListener('change', function (e) {
            const file = this.files[0];
            if (file && file.type !== "application/pdf") {
                alert("El archivo seleccionado no es un PDF. Por favor, seleccione un documento válido.");
                this.value = ''; // Limpiar el input
            }
        });

    document.getElementById('imageInput')?.addEventListener('change', function (e) {
        const previewContainer = document.getElementById('imagePreviewContainer');
     previewContainer.innerHTML = ''; // Limpiar previsualización
    if (this.files.length > 4) {
        alert("Atención: Solo se permite un máximo de 4 fotos. Se descartarán las excedentes.");
        // Opcional: podrías resetear el input si quieres ser estricto
    }

    // Mostrar miniaturas rápidas
    Array.from(this.files).slice(0, 4).forEach(file => {
        const reader = new FileReader();
        reader.onload = function (event) {
            const img = document.createElement('img');
            img.src = event.target.result;
            img.style.width = '100px';
            img.style.height = '100px';
            img.style.objectFit = 'cover';
            img.style.borderRadius = '8px';
            img.className = 'img-thumbnail';
            previewContainer.appendChild(img);
        };
        reader.readAsDataURL(file);
    });
});
        // Solo ejecutar el cálculo de garantía si el elemento existe (si no es stock)
        var deliveryInput = document.getElementById("DeliveryDate");
        if (deliveryInput) {
            setupWarrantyDateAutoCalc("DeliveryDate", "warrantyDatePreview");
        }
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}