@model Control_Machine_Sistem.Models.Machine

@{
    ViewData["Title"] = "Eliminar Venta";
}

<link href="~/css/views.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

<div class="content-wrapper">
    <h1 class="page-title">@ViewData["Title"]</h1>
    <h4 class="form-sub-title">¿Estás seguro de que quieres eliminar esta venta?</h4>
    <hr />

    <div class="alert alert-danger" role="alert">
        <i class="fas fa-exclamation-triangle icon"></i>
        La venta, así como todos sus documentos, serán eliminados de forma permanente.
    </div>

    <div class="details-container">
        <dl class="details-list">
            <div class="details-item">
                <dt>@Html.DisplayNameFor(model => model.Customer!.Name)</dt>
                <dd>@Html.DisplayFor(model => model.Customer!.Name)</dd>
            </div>
            <div class="details-item">
                <dt>@Html.DisplayNameFor(model => model.Model!.Name)</dt>
                <dd>@Html.DisplayFor(model => model.Model!.Name)</dd>
            </div>
            <div class="details-item">
                <dt>@Html.DisplayNameFor(model => model.ChasisNumber)</dt>
                <dd>@Html.DisplayFor(model => model.ChasisNumber)</dd>
            </div>
            <div class="details-item">
                <dt>@Html.DisplayNameFor(model => model.EngineNumber)</dt>
                <dd>@Html.DisplayFor(model => model.EngineNumber)</dd>
            </div>
            <div class="details-item">
                <dt>@Html.DisplayNameFor(model => model.DeliveryDate)</dt>
                <dd>@Model.DeliveryDate?.ToString("dd/MM/yyyy")</dd>
            </div>
            <div class="details-item">
                <dt>@Html.DisplayNameFor(model => model.WarrantyExpirationDate)</dt>
                <dd>@Model.WarrantyExpirationDate?.ToString("dd/MM/yyyy")</dd>
            </div>
            <div class="details-item">
                <dt>@Html.DisplayNameFor(model => model.DocUrls)</dt>
                <dd>
                    @if (Model.DocUrls != null && Model.DocUrls.Any())
                    {
                        <ul class="file-list">
                            @foreach (var doc in Model.DocUrls)
                            {
                                <li>
                                    <a class="document-name" href="@doc" download>@System.IO.Path.GetFileName(doc)</a>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <span>No se encontraron documentos</span>
                    }
                </dd>
            </div>
        </dl>
    </div>

    <hr />

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div class="button-group">
            <input type="submit" value="Eliminar" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left icon"></i> Volver a la lista
            </a>
        </div>
    </form>
</div>

<script src="~/js/views.js"></script>