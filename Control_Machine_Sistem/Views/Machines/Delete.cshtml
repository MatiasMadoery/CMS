@model Control_Machine_Sistem.Models.Machine

@{
    bool isStock = ViewBag.IsStock ?? false;
    ViewData["Title"] = isStock ? "Eliminar Unidad de Stock" : "Eliminar Venta";
}

<link href="~/css/views.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

<div class="content-wrapper">
    <h1 class="page-title">@ViewData["Title"]</h1>
    <h4 class="form-sub-title">@(isStock ? "¿Estás seguro de que quieres eliminar esta unidad del inventario?" : "¿Estás seguro de que quieres eliminar esta venta?")</h4>
    <hr />

    <div class="alert alert-danger" role="alert">
        <i class="fas fa-exclamation-triangle icon"></i>
        Los datos de la @(isStock ? "unidad" : "venta") y todos sus documentos asociados serán eliminados de forma permanente.
    </div>

    <div class="details-container">
        <dl class="details-list">
            @if (!isStock)
            {
                <div class="details-item">
                    <dt>@Html.DisplayNameFor(model => model.Customer!.Name)</dt>
                    <dd>@Html.DisplayFor(model => model.Customer!.Name)</dd>
                </div>
            }
            <div class="details-item">
                <dt>@Html.DisplayNameFor(model => model.Model!.Name)</dt>
                <dd>@Html.DisplayFor(model => model.Model!.Name)</dd>
            </div>
            <div class="details-item">
                <dt>@Html.DisplayNameFor(model => model.ChasisNumber)</dt>
                <dd>@Html.DisplayFor(model => model.ChasisNumber)</dd>
            </div>
            <div class="details-item">
                <dt>@Html.DisplayNameFor(model => model.EngineNumber)</dt>
                <dd>@Html.DisplayFor(model => model.EngineNumber)</dd>
            </div>
            @if (!isStock)
            {
                <div class="details-item">
                    <dt>@Html.DisplayNameFor(model => model.DeliveryDate)</dt>
                    <dd>@Model.DeliveryDate?.ToString("dd/MM/yyyy")</dd>
                </div>
                <div class="details-item">
                    <dt>@Html.DisplayNameFor(model => model.WarrantyExpirationDate)</dt>
                    <dd>@Model.WarrantyExpirationDate?.ToString("dd/MM/yyyy")</dd>
                </div>
            }
            <div class="details-item">
                <dt>@Html.DisplayNameFor(model => model.DocUrls)</dt>
                <dd>
                    @if (Model.DocUrls != null && Model.DocUrls.Any())
                    {
                        <ul class="file-list">
                            @foreach (var doc in Model.DocUrls)
                            {
                                <li>
                                    <a class="document-name" href="@doc" download>@System.IO.Path.GetFileName(doc)</a>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <span>No se encontraron documentos</span>
                    }
                </dd>
            </div>
            @* --- GESTIÓN DE CHECKLIST EN ELIMINACIÓN --- *@
            <div class="details-item">
                <dt>Checklist de Entrega</dt>
                <dd>
                    @if (!string.IsNullOrEmpty(Model.CheckListUrl))
                    {
                        <a href="@Model.CheckListUrl" target="_blank" class="btn btn-sm btn-outline-info">
                            <i class="fas fa-file-pdf"></i> Ver Checklist adjunto
                        </a>
                    }
                    else
                    {
                        <span class="text-muted">No se cargó checklist</span>
                    }
                </dd>
            </div>         
        </dl>
    </div>

    <hr />

    <form asp-action="Delete" asp-route-isStock="@isStock">
        <input type="hidden" asp-for="Id" />
        <div class="button-group">
            <button type="submit" class="btn btn-danger">
                <i class="fas fa-trash-alt icon"></i> Confirmar Eliminación
            </button>
            <a asp-controller="Stock" asp-action="@(isStock ? "Index" : "Vendidos")" class="btn btn-secondary">
                <i class="fas fa-arrow-left icon"></i> Cancelar
            </a>
        </div>
    </form>
</div>

<script src="~/js/views.js"></script>