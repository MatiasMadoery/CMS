@model Control_Machine_Sistem.Models.Machine

@{
    bool isStock = ViewBag.IsStock ?? false;
    ViewData["Title"] = isStock ? "Detalle de Stock" : "Detalle de Máquina";
}

<link href="~/css/views.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

<div class="content-wrapper">
    <h1 class="page-title">@ViewData["Title"]</h1>
    <hr />

    <div class="details-container">
        <dl class="details-list">
            @if (!isStock)
            {
                <div class="details-item">
                    <dt>@Html.DisplayNameFor(model => model.Customer!.Name)</dt>
                    <dd>@Html.DisplayFor(model => model.Customer!.Name)</dd>
                </div>
            }
            <div class="details-item">
                <dt>@Html.DisplayNameFor(model => model.Ubication!.Name)</dt>
                <dd>@Html.DisplayFor(model => model.Ubication!.Name)</dd>
            </div>
            <div class="details-item">
                <dt>@Html.DisplayNameFor(model => model.Model!.Name)</dt>
                <dd>@Html.DisplayFor(model => model.Model!.Name)</dd>
            </div>

            @*Nuevas prop*@
            <div class="details-item">
                <dt>@Html.DisplayNameFor(model => model.ImportNumber)</dt>
                <dd>@Html.DisplayFor(model => model.ImportNumber)</dd>
            </div>
            <div class="details-item">
                <dt>@Html.DisplayNameFor(model => model.OfficializationDate)</dt>
                <dd>@Model.OfficializationDate.ToString("dd/MM/yyyy")</dd>
            </div>

            <div class="details-item">
                <dt>@Html.DisplayNameFor(model => model.ChasisNumber)</dt>
                <dd>@Html.DisplayFor(model => model.ChasisNumber)</dd>
            </div>
            <div class="details-item">
                <dt>@Html.DisplayNameFor(model => model.EngineNumber)</dt>
                <dd>@Html.DisplayFor(model => model.EngineNumber)</dd>
            </div>
            <div class="details-item">
                <dt>@Html.DisplayNameFor(model => model.SerialNumber)</dt>
                <dd>@Html.DisplayFor(model => model.SerialNumber)</dd>
            </div>
            <div class="details-item">
                <dt>Año de Fabricación</dt>
                <dd>@Html.DisplayFor(model => model.ManufactureYear)</dd>
            </div>
            <div class="details-item">
                <dt>Horas de Uso</dt>
                <dd>@Html.DisplayFor(model => model.UserHours) hs</dd>
            </div>

            @* --- SECCIÓN DE FOTOS IGUAL A EDIT --- *@
            <div class="details-item full-width">
                <dt class="mb-2"><i class="fas fa-images icon"></i> Fotos de la Unidad</dt>
                <dd>
                    @if (Model.ImageUrls != null && Model.ImageUrls.Any())
                    {
                        <div class="machine-photo-grid">
                            @foreach (var url in Model.ImageUrls)
                            {
                                <div class="photo-item-edit">
                                    <img src="@url" alt="Foto máquina" class="img-thumbnail img-zoomable" onclick="openZoom(this.src)" />
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <span class="text-muted"><i class="fas fa-camera-retro"></i> No hay fotos cargadas para esta unidad.</span>
                    }
                </dd>
            </div>

            @if (!isStock)
            {
                <div class="details-item">
                    <dt>@Html.DisplayNameFor(model => model.DeliveryDate)</dt>
                    <dd>@Model.DeliveryDate?.ToString("dd/MM/yyyy")</dd>
                </div>
                <div class="details-item">
                    <dt>@Html.DisplayNameFor(model => model.WarrantyExpirationDate)</dt>
                    <dd>@Model.WarrantyExpirationDate?.ToString("dd/MM/yyyy")</dd>
                </div>
            }

            <div class="details-item">
                <dt>@Html.DisplayNameFor(model => model.DocUrls)</dt>
                <dd>
                    @if (Model.DocUrls != null && Model.DocUrls.Any())
                    {
                        <ul class="file-list">
                            @foreach (var document in Model.DocUrls)
                            {
                                <li>
                                    <a class="document-name" href="@document" download>@System.IO.Path.GetFileName(document)</a>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <span>No se encontró documentación</span>
                    }
                </dd>
            </div>
        </dl>
    </div>

    @if (!isStock)
    {
        <hr />
        <div class="document-management">
            <h4 class="form-section-title">Historial de propietarios</h4>
            <div class="data-table-container">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Propietario anterior</th>
                            <th>Fecha de cambio</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.OwnerHistories != null && Model.OwnerHistories.Any())
                        {
                            @foreach (var history in Model.OwnerHistories!)
                            {
                                <tr>
                                    <td>@history.PreviousOwner</td>
                                    <td>@history.ChangeDate.ToString("dd/MM/yyyy")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="2" class="text-center text-secondary">No hay historial de propietarios.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <hr />

    <div class="button-group">
        <a asp-action="Edit" asp-route-id="@Model?.Id" asp-route-isStock="@isStock" class="btn btn-primary">
            <i class="fas fa-edit icon"></i> Editar
        </a>
        <a asp-action="Delete" asp-route-id="@Model?.Id" asp-route-isStock="@isStock" class="btn btn-danger">
            <i class="fas fa-trash-alt icon"></i> Eliminar
        </a>
        <a asp-controller="Stock" asp-action="@(isStock ? "Index" : "Vendidos")" class="btn btn-secondary">
            <i class="fas fa-arrow-left icon"></i> Volver
        </a>
    </div>
</div>

@* Modal para el Zoom de imágenes *@
<div id="zoomModal" class="zoom-modal" onclick="closeZoom()">
    <span class="zoom-close">&times;</span>
    <img class="zoom-content" id="imgZoom">
</div>

<style>
    /* Mantenemos los estilos de la grilla y el zoom */
    .machine-photo-grid {
        display: flex;
        gap: 15px;
        flex-wrap: wrap;
        margin-top: 10px;
    }

    .photo-item-edit {
        position: relative;
        width: 120px;
        height: 120px;
    }

        .photo-item-edit img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 8px;
            cursor: pointer;
            transition: transform 0.2s;
        }

            .photo-item-edit img:hover {
                transform: scale(1.05);
            }

    /* Estilos del Modal de Zoom */
    .zoom-modal {
        display: none;
        position: fixed;
        z-index: 9999;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.9);
        align-items: center;
        justify-content: center;
    }

    .zoom-content {
        max-width: 90%;
        max-height: 90%;
        border-radius: 5px;
        animation: zoomIn 0.3s;
    }

    .zoom-close {
        position: absolute;
        top: 20px;
        right: 35px;
        color: #f1f1f1;
        font-size: 40px;
        cursor: pointer;
    }

    @@keyframes zoomIn {
        from {
            transform: scale(0)
        }

        to {
            transform: scale(1)
        }
    }
</style>

@section Scripts {
    <script>
        function openZoom(src) {
            const modal = document.getElementById("zoomModal");
            const img = document.getElementById("imgZoom");
            modal.style.display = "flex";
            img.src = src;
        }

        function closeZoom() {
            document.getElementById("zoomModal").style.display = "none";
        }
    </script>
}