@model Control_Machine_Sistem.Models.Machine

@{
    ViewData["Title"] = "Details";
}

<h1>Detalle</h1>

<div>    
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Customer!.FullName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Customer!.FullName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Model!.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Model!.Name)
        </dd>          
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ChasisNumber)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ChasisNumber)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.EngineNumber)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.EngineNumber)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DeliveryDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DeliveryDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.WarrantyExpirationDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.WarrantyExpirationDate)
        </dd>
        <dt class="col-sm-2">
         <br />
            @Html.DisplayNameFor(model => model.DocUrls)
        </dt>
        <dd class="col-sm-10">
            <br />
            @if (Model.DocUrls != null && Model.DocUrls.Any())
            {
                <ul>
                    @foreach (var document in Model.DocUrls)
                    {
                        <li class="document-name" data-url="@document">
                            <a href="@document" download>@document</a>
                        </li>
                    }
                </ul>
            }
            else
            {
                <span>No se encontró documentación</span>
            }
        </dd>
    </dl>
</div>
<br />
<hr />
<div class="form-group">
    <label><b>Historial de propietarios de la máquina: </b></label>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Propietario anterior</th>
                <th>Fecha de cambio</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var history in Model.OwnerHistories!)
            {
                <tr>
                    <td>@history.PreviousOwner</td>
                    <td>@history.ChangeDate.ToString("dd/MM/yyyy")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<hr />
<br />
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Editar</a> |
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a> |
    <a asp-action="Delete" asp-route-id="@Model?.Id" class="btn btn-danger">Eliminar</a>
</div>

<script src="~/js/views.js"></script>