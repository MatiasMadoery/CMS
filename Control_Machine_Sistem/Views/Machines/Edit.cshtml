@model Control_Machine_Sistem.Models.Machine

@{
    bool isStock = ViewBag.IsStock ?? false;
    ViewData["Title"] = isStock ? "Editar Máquina en Stock" : "Editar Venta de Máquina";
}

<link href="~/css/views.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

<div class="form-container">
    <h1 class="form-title">@ViewData["Title"]</h1>
    <h4 class="form-sub-title">Modifique los datos necesarios</h4>
    <hr />

    <form asp-action="Edit" enctype="multipart/form-data" id="uploadForm" asp-route-isStock="@isStock">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />

        <div class="form-row">
            @if (!isStock)
            {
                <div class="form-col">
                    <div class="form-group">
                        <label asp-for="CustomerId" class="form-label">Cliente / Propietario</label>
                        <select asp-for="CustomerId" class="form-control select2" data-url="@Url.Action("GetCustomers", "Machines")">
                            <option value="">Seleccione un Cliente...</option>
                            @if (Model.CustomerId != null && ViewBag.CustomerName != null)
                            {
                                <option value="@Model.CustomerId" selected="selected">@ViewBag.CustomerName</option>
                            }
                        </select>
                        <span asp-validation-for="CustomerId" class="text-danger"></span>
                    </div>
                </div>
            }
            <div class="form-col">
                <div class="form-group">
                    <label asp-for="ModelId" class="form-label"></label>
                    <select asp-for="ModelId" class="form-control" asp-items="ViewBag.ModelId"></select>
                </div>
            </div>
        </div>

        <div class="form-row">
            <div class="form-col">
                <div class="form-group">
                    <label asp-for="ChasisNumber" class="form-label"></label>
                    <input asp-for="ChasisNumber" class="form-control" />
                    <span asp-validation-for="ChasisNumber" class="text-danger"></span>
                </div>
            </div>
            <div class="form-col">
                <div class="form-group">
                    <label asp-for="EngineNumber" class="form-label"></label>
                    <input asp-for="EngineNumber" class="form-control" />
                    <span asp-validation-for="EngineNumber" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="form-row">
            <div class="form-col">
                <div class="form-group">
                    <label asp-for="DeliveryDate" class="form-label"></label>
                    <input asp-for="DeliveryDate" class="form-control" type="date" />
                    <span asp-validation-for="DeliveryDate" class="text-danger"></span>
                </div>
            </div>
            <div class="form-col">
                <div class="form-group">
                    <label asp-for="WarrantyExpirationDate" class="form-label"></label>
                    <input asp-for="WarrantyExpirationDate" type="date" class="form-control" readonly id="WarrantyExpirationDate" />
                    <span asp-validation-for="WarrantyExpirationDate" class="text-danger"></span>
                </div>
            </div>
        </div>

        <h4 class="form-section-title">Archivos cargados</h4>
        <div class="document-management">
            <table class="data-table">
                <tbody>
                    @if (Model.DocUrls != null && Model.DocUrls.Any())
                    {
                        @for (int i = 0; i < Model.DocUrls.Count; i++)
                        {
                            <tr class="document-row">
                                <td>
                                    <a href="@Model.DocUrls[i]" download class="document-name">@System.IO.Path.GetFileName(Model.DocUrls[i])</a>
                                    <input type="hidden" name="ExistingDocs" value="@Model.DocUrls[i]" />
                                </td>
                                <td class="table-actions">
                                    <button type="button" class="btn-file-delete" onclick="removeExistingFile(this, 'DeletedDocs')">
                                        <i class="fas fa-trash-alt icon"></i> Eliminar
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="2" class="text-center text-secondary">No hay archivos cargados.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <h4 class="form-section-title">Agregar nuevos documentos</h4>
        <div id="fileUploadContainer">
            <div class="form-group">
                <label asp-for="Documentations" class="form-label"></label>
                <input type="file" name="Documentations" class="form-control" multiple />
                <span asp-validation-for="Documentations" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <button type="button" class="btn btn-primary" onclick="addMoreFiles('fileUploadContainer', 'Documentations')">
                <i class="fas fa-plus icon"></i> Agregar otro archivo
            </button>
        </div>

        <div class="button-group">
            <button type="submit" class="btn btn-success">
                <i class="fas fa-save icon"></i> Guardar Cambios
            </button>
            <a asp-controller="Stock" asp-action="@(isStock ? "Index" : "Vendidos")" class="btn btn-secondary">
                <i class="fas fa-arrow-left icon"></i> Cancelar
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/views.js"></script>
    <script src="~/js/machineCreateForm.js"></script>
    <script>
        setupWarrantyDateAutoCalc("DeliveryDate", "WarrantyExpirationDate");
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}