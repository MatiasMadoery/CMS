@model Control_Machine_Sistem.Models.Machine

@{
    bool isStock = ViewBag.IsStock ?? false;
    ViewData["Title"] = isStock ? "Editar Máquina en Stock" : "Editar Venta de Máquina";
}

<link href="~/css/views.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

<div class="form-container">
    <h1 class="form-title">@ViewData["Title"]</h1>
    <h4 class="form-sub-title">Modifique los datos necesarios</h4>
    <hr />

    <form asp-action="Edit" enctype="multipart/form-data" id="uploadForm" asp-route-isStock="@isStock">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />

        <div class="form-row">
            @if (!isStock)
            {
                <div class="form-col">
                    <div class="form-group">
                        <label asp-for="CustomerId" class="form-label">Cliente / Propietario</label>
                        <select asp-for="CustomerId" class="form-control select2" data-url="@Url.Action("GetCustomers", "Machines")">
                            <option value="">Seleccione un Cliente...</option>
                            @if (Model.CustomerId != null && ViewBag.CustomerName != null)
                            {
                                <option value="@Model.CustomerId" selected="selected">@ViewBag.CustomerName</option>
                            }
                        </select>
                        <span asp-validation-for="CustomerId" class="text-danger"></span>
                    </div>
                </div>
            }
            <div class="form-col">
                <div class="form-group">
                    <label asp-for="ModelId" class="form-label"></label>
                    <select asp-for="ModelId" class="form-control" asp-items="ViewBag.ModelId"></select>
                </div>
            </div>
        </div>

        @*Nuevas prop*@

        <div class="form-row">
            <div class="form-col">
                <div class="form-group">
                    <label asp-for="ImportNumber" class="form-label">Número de Importación</label>
                    <input asp-for="ImportNumber" class="form-control" type="number"/>
                    <span asp-validation-for="ImportNumber" class="text-danger"></span>
                </div>
            </div>
            <div class="form-col">
                <div class="form-group">
                    <label asp-for="OfficializationDate" class="form-label">Fecha de Oficialización</label>
                    <input asp-for="OfficializationDate" class="form-control" type="date"/>
                    <span asp-validation-for="OfficializationDate" class="text-danger"></span>
                </div>
            </div>
            
        </div>

        <div class="form-row">
            <div class="form-col">
                <div class="form-group">
                    <label asp-for="ChasisNumber" class="form-label">Número de Chasis</label>
                    <input asp-for="ChasisNumber" class="form-control" />
                    <span asp-validation-for="ChasisNumber" class="text-danger"></span>
                </div>
            </div>
            <div class="form-col">
                <div class="form-group">
                    <label asp-for="EngineNumber" class="form-label">Número de Motor</label>
                    <input asp-for="EngineNumber" class="form-control" />
                    <span asp-validation-for="EngineNumber" class="text-danger"></span>
                </div>
            </div>
            <div class="form-col">
                <div class="form-group">
                    <label asp-for="SerialNumber" class="form-label">Número de Serie</label>
                    <input asp-for="SerialNumber" class="form-control" />
                    <span asp-validation-for="SerialNumber" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="form-row">
            <div class="form-col">
                <div class="form-group">
                    <label asp-for="ManufactureYear" class="form-label">Año de Fabricación</label>
                    <input asp-for="ManufactureYear" class="form-control" type="number" />
                    <span asp-validation-for="ManufactureYear" class="text-danger"></span>
                </div>
            </div>
            <div class="form-col">
                <div class="form-group">
                    <label asp-for="UserHours" class="form-label">Horas de Uso</label>
                    <input asp-for="UserHours" class="form-control" type="number" step="0.1" />
                    <span asp-validation-for="UserHours" class="text-danger"></span>
                </div>
            </div>
            <div class="form-col">
                <div class="form-group">
                    <label asp-for="UbicationId" class="form-label">Ubicación / Sucursal</label>
                    <select asp-for="UbicationId" class="form-select" asp-items="ViewBag.UbicationId">
                        <option value="">-- Seleccionar Ubicación --</option>
                    </select>
                    <span asp-validation-for="UbicationId" class="text-danger"></span>
                </div>
            </div>
        </div>

        @if (!isStock)
        {
            <h4 class="form-section-title"><i class="fas fa-calendar-alt icon"></i> Entrega y Garantía</h4>
            <div class="form-row">
                <div class="form-col">
                    <div class="form-group">
                        <label asp-for="DeliveryDate" class="form-label">Fecha de Entrega Técnica</label>
                        <input asp-for="DeliveryDate" class="form-control" type="date" />
                        <span asp-validation-for="DeliveryDate" class="text-danger"></span>
                    </div>
                </div>
                <div class="form-col">
                    <div class="form-group">
                        <label asp-for="WarrantyExpirationDate" class="form-label">Vencimiento de Garantía</label>
                        <input asp-for="WarrantyExpirationDate" type="date" class="form-control" readonly id="WarrantyExpirationDate" />
                        <span asp-validation-for="WarrantyExpirationDate" class="text-danger"></span>
                    </div>
                </div>
            </div>
        }

        @* --- SECCIÓN DE CHECKLIST DE ENTREGA --- *@
        <h4 class="form-section-title"><i class="fas fa-clipboard-check icon"></i> Checklist de Entrega</h4>
        <div class="document-management mb-4">
            <div class="form-group">
                @if (!string.IsNullOrEmpty(Model.CheckListUrl))
                {
                    <div id="checklist-container" class="alert alert-info d-flex justify-content-between align-items-center">
                        <div>
                            <i class="fas fa-file-pdf"></i>
                            <a href="@Model.CheckListUrl" target="_blank" class="document-name">Ver Checklist Actual</a>
                        </div>
                        <button type="button" class="btn btn-sm btn-danger" onclick="markChecklistForDeletion('@Model.CheckListUrl')">
                            <i class="fas fa-times"></i>Eliminar
                        </button>
                        @* Campo oculto para indicar si se debe borrar el actual *@
                        <input type="hidden" id="DeleteChecklistInput" name="DeleteChecklist" value="false" />
                    </div>
                }

                <label class="form-label">@(string.IsNullOrEmpty(Model.CheckListUrl) ? "Subir Checklist (PDF)" : "Subir nuevo Checklist para reemplazar")</label>
                <input asp-for="CheckListFile" type="file" class="form-control" accept="application/pdf" />
                <span asp-validation-for="CheckListFile" class="text-danger"></span>
            </div>
        </div>

        @* --- SECCIÓN DE FOTOS EXISTENTES --- *@
        <h4 class="form-section-title"><i class="fas fa-images icon"></i> Fotos de la Unidad</h4>
        <div class="document-management mb-4">
            <div class="machine-photo-grid">
                @if (Model.ImageUrls != null && Model.ImageUrls.Any())
                {
                    @foreach (var url in Model.ImageUrls)
                    {
                        <div class="photo-item-edit" id="photo-@url.GetHashCode()">
                            <img src="@url" alt="Foto máquina" class="img-thumbnail img-zoomable" onclick="openZoom(this.src)" />
                            <input type="hidden" name="ExistingImageUrls" value="@url" />
                            <button type="button" class="btn-delete-photo" onclick="markImageForDeletion('@url', '@url.GetHashCode()')">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted">No hay fotos cargadas.</p>
                }
            </div>
        </div>

        @* Input para agregar fotos nuevas *@
        <div class="form-group mb-4">
            <label class="form-label">Subir fotos nuevas (Máximo 4 totales)</label>
            <input asp-for="ImageFiles" type="file" class="form-control" multiple accept="image/*" />
            <span asp-validation-for="ImageFiles" class="text-danger"></span>
        </div>

        @* Campo oculto para las fotos que el usuario decida borrar *@
        <div id="deletedImagesContainer"></div>

        <h4 class="form-section-title">Archivos cargados</h4>
        <div class="document-management">
            <table class="data-table">
                <tbody>
                    @if (Model.DocUrls != null && Model.DocUrls.Any())
                    {
                        @for (int i = 0; i < Model.DocUrls.Count; i++)
                        {
                            <tr class="document-row">
                                <td>
                                    <a href="@Model.DocUrls[i]" download class="document-name">@System.IO.Path.GetFileName(Model.DocUrls[i])</a>
                                    <input type="hidden" name="ExistingDocs" value="@Model.DocUrls[i]" />
                                </td>
                                <td class="table-actions">
                                    <button type="button" class="btn-file-delete" onclick="removeExistingFile(this, 'DeletedDocs')">
                                        <i class="fas fa-trash-alt icon"></i> Eliminar
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="2" class="text-center text-secondary">No hay archivos cargados.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <h4 class="form-section-title">Agregar nuevos documentos</h4>
        <div id="fileUploadContainer">
            <div class="form-group">
                <label asp-for="Documentations" class="form-label"></label>
                <input type="file" name="Documentations" class="form-control" multiple />
                <span asp-validation-for="Documentations" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <button type="button" class="btn btn-primary" onclick="addMoreFiles('fileUploadContainer', 'Documentations')">
                <i class="fas fa-plus icon"></i> Agregar otro archivo
            </button>
        </div>

        <div class="button-group">
            <button type="submit" class="btn btn-success">
                <i class="fas fa-save icon"></i> Guardar Cambios
            </button>
            <a asp-controller="Stock" asp-action="@(isStock ? "Index" : "Vendidos")" class="btn btn-secondary">
                <i class="fas fa-arrow-left icon"></i> Cancelar
            </a>
        </div>
    </form>
</div>
<div id="zoomModal" class="zoom-modal" onclick="closeZoom()">
    <span class="zoom-close">&times;</span>
    <img class="zoom-content" id="imgZoom">
</div>

<style>
    /* Estilo para la grilla en edición */
    .machine-photo-grid { display: flex; gap: 15px; flex-wrap: wrap; }
    .photo-item-edit { position: relative; width: 120px; height: 120px; }
    .photo-item-edit img { width: 100%; height: 100%; object-fit: cover; border-radius: 8px; cursor: pointer; }

    /* Botón para borrar foto individual */
    .btn-delete-photo {
        position: absolute; top: -5px; right: -5px;
        background: #ff4d4d; color: white; border: none;
        border-radius: 50%; width: 25px; height: 25px;
        cursor: pointer; font-size: 12px; display: flex; align-items: center; justify-content: center;
        box-shadow: 0 2px 5px rgba(0,0,0,0.2);
    }

    /* Estilos del Modal de Zoom */
    .zoom-modal {
        display: none; position: fixed; z-index: 9999;
        left: 0; top: 0; width: 100%; height: 100%;
        background-color: rgba(0,0,0,0.9); align-items: center; justify-content: center;
    }
    .zoom-content { max-width: 90%; max-height: 90%; border-radius: 5px; animation: zoomIn 0.3s; }
    .zoom-close { position: absolute; top: 20px; right: 35px; color: #f1f1f1; font-size: 40px; cursor: pointer; }

    @@keyframes zoomIn { from {transform:scale(0)} to {transform:scale(1)} }
</style>

@section Scripts {
    <script src="~/js/views.js"></script>
    <script src="~/js/machineCreateForm.js"></script>
    <script>
        setupWarrantyDateAutoCalc("DeliveryDate", "WarrantyExpirationDate");

                function markChecklistForDeletion(url) {
            if (confirm("¿Deseas quitar el checklist actual? Se borrará permanentemente al guardar.")) {
                // Ocultamos el contenedor visual
                document.getElementById("checklist-container").classList.add("d-none");
                // Cambiamos el valor del input oculto para que el controlador sepa que debe borrarlo de Azure
                document.getElementById("DeleteChecklistInput").value = "true";
            }
        }

        // Función para el Zoom
        function openZoom(src) {
            const modal = document.getElementById("zoomModal");
            const img = document.getElementById("imgZoom");
            modal.style.display = "flex";
            img.src = src;
        }

        function closeZoom() {
            document.getElementById("zoomModal").style.display = "none";
        }

        // Función para "borrar" la foto de la vista y enviarla al controlador para eliminar de Azure
        function markImageForDeletion(url, idHash) {
            if (confirm("¿Estás seguro de que quieres eliminar esta foto?")) {
                // 1. Ocultar la foto de la vista
                document.getElementById("photo-" + idHash).style.display = "none";

                // 2. Crear un input oculto para que el controlador sepa qué borrar en Azure/DB
                const container = document.getElementById("deletedImagesContainer");
                const input = document.createElement("input");
                input.type = "hidden";
                input.name = "DeletedImageUrls"; // Nacho debe recibir este String[] en el Post
                input.value = url;
                container.appendChild(input);
            }
        }
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}