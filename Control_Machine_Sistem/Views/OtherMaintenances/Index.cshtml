@model IEnumerable<Control_Machine_Sistem.Models.OtherMaintenance>

@{
    ViewData["Title"] = "Otros Mantenimientos";
    var contextMachineId = ViewData["MachineId"];
}

<h1 class="mb-4">Otros Mantenimientos</h1>

<p>
    <a class="btn btn-success" asp-action="Create" asp-route-machineId="@(contextMachineId)">
        <i class="fas fa-plus-circle icon"></i> Crear nuevo
    </a>
</p>

<table class="table table-striped table-bordered">
    <thead class="table-light">
        <tr>
            <th>@Html.DisplayNameFor(model => model.WorkHours)</th>
            <th>@Html.DisplayNameFor(model => model.ServiceDate)</th>
            <th>@Html.DisplayNameFor(model => model.OrderNumber)</th>
            <th>@Html.DisplayNameFor(model => model.Observations)</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.WorkHours)</td>
                <td>@(item.ServiceDate?.ToString("dd/MM/yyyy"))</td>
                <td>@Html.DisplayFor(modelItem => item.OrderNumber)</td>
                <td>@Html.DisplayFor(modelItem => item.Observations)</td>
                <td>
                    <div class="btn-group btn-group-sm" role="group">
                        <a class="btn btn-warning" asp-action="Edit" asp-route-id="@item.Id" asp-route-machineId="@(contextMachineId ?? item.MachineId)">Editar</a>
                        <a class="btn btn-info" asp-action="Details" asp-route-id="@item.Id" asp-route-machineId="@(contextMachineId ?? item.MachineId)">Detalles</a>
                        <a class="btn btn-danger" asp-action="Delete" asp-route-id="@item.Id" asp-route-machineId="@(contextMachineId ?? item.MachineId)">Eliminar</a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">
    <a asp-controller="Maintenance" asp-action="Index" class="btn btn-secondary">
        <i class="fas fa-arrow-left icon"></i> Volver
    </a>
</div>
