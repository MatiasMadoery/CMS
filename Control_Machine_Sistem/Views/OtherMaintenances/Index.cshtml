@model IEnumerable<Control_Machine_Sistem.Models.OtherMaintenance>

@{
    ViewData["Title"] = "Otros mantenimientos";
    
    var contextMachineId = ViewData["MachineId"];
}

<h1>Otros mantenimientos</h1>

<p>    
    <a asp-action="Create" asp-route-machineId="@(contextMachineId)">Crear nuevo</a>
</p>
<table class="table">
    <thead>
        <tr>           
            <th>
                @Html.DisplayNameFor(model => model.WorkHours)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ServiceDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OrderNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Observations)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>               
                <td>
                    @Html.DisplayFor(modelItem => item.WorkHours)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ServiceDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.OrderNumber)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Observations)
                </td>
                <td>                    
                    <a asp-action="Edit" asp-route-id="@item.Id" asp-route-machineId="@(contextMachineId ?? item.MachineId)">Editar</a> |
                    <a asp-action="Details" asp-route-id="@item.Id" asp-route-machineId="@(contextMachineId ?? item.MachineId)">Detalle</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id" asp-route-machineId="@(contextMachineId ?? item.MachineId)">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
