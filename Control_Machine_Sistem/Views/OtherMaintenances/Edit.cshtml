@model Control_Machine_Sistem.Models.OtherMaintenance

@{
    ViewData["Title"] = "Editar Mantenimiento";
    var machineId = ViewData["MachineId"] ?? Model.MachineId;
}

<link href="~/css/views.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

<div class="form-container">
    <h1 class="form-title">@ViewData["Title"]</h1>
    <hr />

    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="MachineId" />

        <div class="form-row">
            <div class="form-col">
                <div class="form-group">
                    <label asp-for="WorkHours" class="form-label"></label>
                    <input asp-for="WorkHours" class="form-control" />
                    <span asp-validation-for="WorkHours" class="text-danger"></span>
                </div>
            </div>
            <div class="form-col">
                <div class="form-group">
                    <label asp-for="ServiceDate" class="form-label"></label>
                    <input asp-for="ServiceDate" type="date" class="form-control" />
                    <span asp-validation-for="ServiceDate" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="form-row">
            <div class="form-col">
                <div class="form-group">
                    <label asp-for="OrderNumber" class="form-label">N° Orden *</label>
                    <input asp-for="OrderNumber" class="form-control" />
                    <span asp-validation-for="OrderNumber" class="text-danger"></span>
                </div>
            </div>
            <div class="form-col">
                <div class="form-group">
                    <label asp-for="Observations" class="form-label"></label>
                    <input asp-for="Observations" class="form-control" />
                    <span asp-validation-for="Observations" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="button-group">
            <input type="submit" value="Guardar" class="btn btn-success" />
            <a asp-action="Index" asp-route-machineId="@(machineId)" class="btn btn-secondary">
                <i class="fas fa-arrow-left icon"></i> Volver a la lista
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}