@model Control_Machine_Sistem.Models.OtherMaintenance

@{
    ViewData["Title"] = "Detalle Mantenimiento";
    var machineId = ViewData["MachineId"];
}

<link href="~/css/views.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

<div class="content-wrapper">
    <h1 class="page-title">@ViewData["Title"]</h1>
    <hr />

    <div class="details-container">
        <dl class="details-list">
            <div class="details-item">
                <dt>
                    @Html.DisplayNameFor(model => model.WorkHours)
                </dt>
                <dd>
                    @Html.DisplayFor(model => model.WorkHours)
                </dd>
            </div>
            <div class="details-item">
                <dt>
                    @Html.DisplayNameFor(model => model.ServiceDate)
                </dt>
                <dd>
                    @Model.ServiceDate?.ToString("dd/MM/yyyy")
                </dd>
            </div>
            <div class="details-item">
                <dt>
                    @Html.DisplayNameFor(model => model.OrderNumber)
                </dt>
                <dd>
                    @Html.DisplayFor(model => model.OrderNumber)
                </dd>
            </div>
            <div class="details-item">
                <dt>
                    @Html.DisplayNameFor(model => model.Observations)
                </dt>
                <dd>
                    @Html.DisplayFor(model => model.Observations)
                </dd>
            </div>
        </dl>
    </div>

    <div class="button-group">
        <a asp-action="Edit" asp-route-id="@Model.Id" asp-route-machineId="@(machineId)" class="btn btn-primary">
            <i class="fas fa-edit icon"></i> Editar
        </a>
        <a asp-action="Index" asp-route-machineId="@(machineId)" class="btn btn-secondary">
            <i class="fas fa-arrow-left icon"></i> Volver a la lista
        </a>
    </div>
</div>