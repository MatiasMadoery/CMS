@using Control_Machine_Sistem.ViewModels
@model Control_Machine_Sistem.ViewModels.ModelDownloadsViewModel

@{
    Layout = null;    
}


<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manuales</title>
    <link rel="stylesheet" href="~/css/downloads.css" />    
</head>
<body>
    <div class="card">
        <div class="card-header">
            <h2>Manuales</h2>
        </div>
        <div class="card-body">
            <ul class="manual-list">
                @foreach (var manual in Model.Manuals)
                {
                    var fileUrl = Url.Content("~/documentation/manuals/" + manual.OriginalName);
                    <li class="manual-item">
                        Descargar:
                        <a href="@Url.Action("DownloadManual", "QrCodes", new { fileName = manual.OriginalName })" target="_blank" class="manual-link">
                            @manual.DisplayName
                        </a>
                    </li>
                }
            </ul>
            <hr />
            <div class="card-header">
                <h3>Consumibles de Services</h3>
            </div>
            <div>
                   <ul class="manual-list">
                @foreach (var kit in Model.SpareKits)
                {
                    <li class="manual-item">
                        Descargar:
                        <a href="@Url.Action("DownloadSpareKit", "QrCodes", new { fileName = kit.OriginalName })" target="_blank" class="manual-link">
                            @kit.DisplayName
                        </a>
                    </li>
                }
            </ul>
            </div class="card-body">         
            <hr />
            <a href="javascript:history.back();" class="btn btn-secondary">Volver al menú principal</a>
        </div>
    </div>
</body>
</html>


