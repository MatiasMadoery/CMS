@using Control_Machine_Sistem.ViewModels
@model List<ManualViewModel>

@{
    Layout = null;    
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manuales de la Máquina</title>
    <link rel="stylesheet" href="~/css/downloads.css" />
</head>
<body>

    <div class="card">
        <div class="card-header">
            <h2>Manuales de la Máquina</h2>
        </div>
        <div class="card-body">
            <ul class="manual-list">
                @foreach (var manual in Model)
                {
                    var fileUrl = Url.Content("~/manuals/models/" + manual.OriginalName);
                    <li class="manual-item">
                        Descargar:
                        <a href="@fileUrl" target="_blank" class="manual-link">
                            @manual.DisplayName
                        </a>
                    </li>
                }
            </ul>

            <a href="javascript:history.back();" class="btn btn-secondary">Volver al menú principal</a>
        </div>
    </div>

</body>
</html>
