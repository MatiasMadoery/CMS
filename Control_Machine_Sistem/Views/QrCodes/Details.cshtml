@model Control_Machine_Sistem.Models.QrCode

@{
    Layout = null;
    ViewData["Title"] = "Detalles de la Máquina";
}


<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detalle de Máquina</title>
    <link rel="stylesheet" href="~/css/scannedQr.css" />
</head>
<body>

    <div class="card">
        <div class="card-header">
            <h3>Sr @Model.ClientName</h3>
        </div>
        <div class="card-body">
            <h4>Modelo de Máquina: @Model.MachineModel</h4>
            <h4>Fecha de Entrega: @Model.DeliveryDate?.ToString("dd/MM/yyyy")</h4>

            <a href="@Url.Action("ManualList", "QrCodes", new { urls = Model.ManualUrl })" class="btn">Descargar Manuales</a>
            <a href="@Url.Action("DocumentList", "QrCodes", new { urls = Model.DocUrl })" class="btn">Descargar Documentación</a>
            <a href="#" class="btn">Descargar Datos del Servicio Técnico</a>
        </div>
    </div>

</body>
</html>
