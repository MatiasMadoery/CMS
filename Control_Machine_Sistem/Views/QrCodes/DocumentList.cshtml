@using Control_Machine_Sistem.ViewModels
@model List<DocumentationViewModel>

    @{
        Layout = null;        
    }

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Documentación de la Máquina</title>
    <link rel="stylesheet" href="~/css/downloads.css" />
</head>
<body>

    <div class="card">
        <div class="card-header">
            <h2>Documentación de la Máquina</h2>
        </div>
        <div class="card-body">
            <ul class="doc-list">
                @foreach (var doc in Model)
                {
                    var fileUrl = Url.Content("~/documentations/machines/" + doc.OriginalName);
                    <li class="doc-item">
                        Descargar:
                        <a href="@fileUrl" target="_blank" class="doc-link">
                            @doc.DisplayName
                        </a>
                    </li>
                }
            </ul>

            <a href="javascript:history.back();" class="btn btn-secondary">Volver al menú principal</a>
        </div>
    </div>

</body>
</html>