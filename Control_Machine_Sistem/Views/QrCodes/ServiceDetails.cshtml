@model IEnumerable<Control_Machine_Sistem.Models.Service>

@{
    Layout = "~/Views/Shared/_QrLayout.cshtml";
    ViewData["Title"] = "Servicios";
    var contextMachineId = ViewData["MachineId"];
    var serviceHours = Enumerable.Range(1, 8).Select(i => i * 250).Prepend(150);
}

<link rel="stylesheet" href="~/css/qrCustomerView.css" />

<title>Services</title>

    @if (!Model.Any())
    {
        <div style="display: flex; justify-content: center; align-items: center; height: 100vh;">
            <div class="card">
                <div class="card-header">
                    <h3>Servicios</h3>
                </div>
                <div class="card-body">
                    <h4>No hay servicios registrados.</h4>
                    <a href="javascript:history.back();" class="btn">Volver atrás</a>
                </div>
            </div>
        </div>
    }
else
{
    <div class="table-responsive">
        <table class="table table-bordered">
            <thead class="thead-light">
                <tr>
                    <th>Service Horas</th>
                    <th>Horas Reales</th>
                    <th>Fecha</th>
                    <th>N° Orden</th>
                    <th>Planilla service</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var hour in serviceHours)
                {
                    var service = Model.FirstOrDefault(s => s.ServiceHour == hour && s.MachineId == (int?)contextMachineId);
                    <tr>
                        <td>@hour</td>
                        @if (service != null)
                        {
                            <td>@service.WorkHours</td>
                            <td>@(service.ServiceDate?.ToString("dd/MM/yyyy"))</td>
                            <td>@service.OrderNumber</td>
                            <td>
                                @if (service.ServiceSheetUrls != null && service.ServiceSheetUrls.Any())
                                {
                                    <ul class="list-unstyled">
                                        @foreach (var sheetUrl in service.ServiceSheetUrls)
                                        {
                                            <li data-url="@sheetUrl">
                                                <a class="document-name" href="@sheetUrl" download>@System.IO.Path.GetFileName(sheetUrl)</a>
                                            </li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <span>Sin planilla</span>
                                }
                            </td>
                        }
                        else
                        {
                            <td colspan="4"><i>No registrado</i></td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="mt-4">
        <a href="javascript:history.back();" class="btn btn-secondary">Volver al menú principal</a>
    </div>
}

<script src="~/js/views.js"></script>
