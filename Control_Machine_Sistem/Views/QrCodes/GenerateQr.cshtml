 @model Control_Machine_Sistem.Models.QrCode
@{
    ViewData["Title"] = "QR Generado";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/qr.css" />   
</head>
<body>

    @* IMPRESION *@
    <div class="qr-container">
        <div class="qr-print-content">
            <h1 class="print-title">MANTENIMIENTO Y DOCUMENTACION</h1>
            <img src="@Model.QrImageBase64" alt="QR Code" class="qr-image-print" />
            <div class="machine-info">
                <h2>MODELO: @Model.MachineModel</h2>
                <h2>N° DE CHASIS: </h2>
            </div>
            <div class="contact-info">
                <h2 class="contact-title">GUARDIA POSVENTA:</h2>
                <p>SERVICIO: +54 03564 - 15572642</p>
                <p>REPUESTOS: +54 03564-572816</p>
            </div>
        </div>

        <div class="no-print">
            <button onclick="window.print()" class="btn btn-success">Imprimir QR</button>
            <br />
            <br />
            <a asp-controller="Machines" asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
        </div>
    </div>
</body>
</html>



@* <img src="~/img/icons/QrPrintViewLogo.png" alt="Qr logo" class="qr-logo" /> *@  