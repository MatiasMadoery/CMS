 @model Control_Machine_Sistem.Models.QrCode
@{
    ViewData["Title"] = "QR Generado";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/qr.css" />   
</head>
<body>

    @* VISTA EN PANTALLA (FONDO AMARILLO) *@
    <div class="qr-container no-print">
        <div class="qr-left">
            <h1 class="center">Modelo: @Model.MachineModel</h1>
            <h1 class="center">N° De Chasis: @Model.ChasisNumber</h1>
            <img src="@Model.QrImageBase64" alt="QR Code" class="qr-image" />
        </div>

        <div class="no-print">
            <button onclick="window.print()" class="btn btn-success">Imprimir QR</button>
            <br />
            <br />
            <a asp-controller="Machines" asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
        </div>
    </div>

    @* ESTRUCTURA DE IMPRESIÓN (OCULTA EN PANTALLA) *@
    <div class="print-qr-card print-only">
        <div class="print-qr-content">
            <img src="@Model.QrImageBase64" alt="QR Code" class="print-qr-image" />
            <div class="print-qr-details">
                <p class="print-model-label">MODELO:</p>
                <p class="print-model-value">@Model.MachineModel</p>
                <p class="print-chasis-label">N° DE CHASIS:</p>
                <p class="print-chasis-value">@Model.ChasisNumber</p>
            </div>
        </div>
    </div>
</body>
</html>
